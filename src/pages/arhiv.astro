---
// Post archive: grid of all posts, newest first (top left), date under each post; below it the campaign posters.
// 2 per row on phones, up to 5 on wide screens. Embeds load on click only (PostCard).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import PostCard from '../components/ui/PostCard.astro';
import Plakati from '../components/ui/Plakati.astro';
import { getStran } from '../lib/strani';
import { getObjave, tipOznaka } from '../lib/objave';

const { naslov, opis, blok } = await getStran('arhiv');
const objave = await getObjave();
const tilt = ['-rotate-1', 'rotate-1', 'rotate-[0.5deg]', '-rotate-[1.5deg]', 'rotate-[1.5deg]'];
const tipi = Object.values(tipOznaka).join(', ').toLowerCase();
// line next to the number of posts ("objav: <types>. …")
const stevilo = blok('stevilo');
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={naslov} uvod={blok('uvod')} oblika="h">
    <p slot="deco" class="max-w-[14rem] text-sm font-medium leading-snug">
      <span class="display block text-6xl text-zelena">{objave.length}</span>
      {stevilo.naslov} {tipi}. {stevilo.besedilo}
    </p>
  </PageIntro>

  <section class="site-container pb-16 pt-2 lg:pb-24" aria-label="Objave">
    <ol class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {objave.map((o, i) => (
        <li><PostCard objava={o} class={tilt[i % tilt.length]} /></li>
      ))}
    </ol>
  </section>

  <Plakati blok={blok('plakati')} />
</BaseLayout>
