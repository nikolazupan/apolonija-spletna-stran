---
// Internal page for the team (/placeholders): what content is still missing and which decisions are open.
// Not linked anywhere, noindex/nofollow, built only while INTERNA_STRAN is on (follows NOINDEX, so it
// is left out of the production build at launch). Plain layout on purpose: no public header/menu/footer.
// Section 1 is generated from the placeholder scan (src/lib/manjkajoce.ts), section 2 from
// src/content/odprte-zadeve/odprte-zadeve.yaml.
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import '../styles/global.css';
import { INTERNA_STRAN, INTERNA_POT } from '../config';
import { getManjkajoce } from '../lib/manjkajoce';

export function getStaticPaths() {
  return INTERNA_STRAN ? [{ params: { interna: INTERNA_POT } }] : [];
}

const { strani, skupaj, placeholderjev } = await getManjkajoce(process.cwd());
const red = { odprto: 0, 'v teku': 1, urejeno: 2 } as const;
// open first, then in progress, then done; within a status in the order of the YAML file
const vrstniRed = [...readFileSync('src/content/odprte-zadeve/odprte-zadeve.yaml', 'utf8').matchAll(/^- id: (\S+)/gm)].map((m) => m[1]);
const zadeve = (await getCollection('odprteZadeve')).sort(
  (a, b) => red[a.data.status] - red[b.data.status] || vrstniRed.indexOf(a.id) - vrstniRed.indexOf(b.id),
);
const odprte = zadeve.filter((z) => z.data.status !== 'urejeno').length;
const posodobljeno = new Intl.DateTimeFormat('sl-SI', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Ljubljana' }).format(new Date());
const steviloStrani = (n: number) => `${n} ${n === 1 ? 'vsebina' : n === 2 ? 'vsebini' : n < 5 ? 'vsebine' : 'vsebin'}`;
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Za ekipo: kaj še manjka</title>
  </head>
  <body class="min-h-screen bg-bela text-crna">
    <main class="mx-auto max-w-3xl px-5 py-8 sm:py-12">
      <p class="text-sm font-bold uppercase tracking-wide text-zelena-temna">Interna stran za ekipo · ne deli javno</p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">Kaj še manjka</h1>
      <p class="mt-2 text-sm text-crna/70">Stanje ob gradnji strani: {posodobljeno}. Seznam se posodobi sam, ko vsebino dodamo.</p>

      <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-base font-bold">
        <a href="#manjkajoce" class="underline underline-offset-4">1. Manjkajoče vsebine</a>
        <a href="#odprte" class="underline underline-offset-4">2. Odprte zadeve ({odprte})</a>
      </nav>

      <!-- 1: generated -->
      <section id="manjkajoce" class="mt-10">
        <h2 class="text-2xl font-extrabold tracking-tight">1. Manjkajoče vsebine</h2>
        <div class="mt-4 rounded-lg bg-krema p-5">
          <p class="text-xl font-extrabold">{skupaj === 0 ? 'Vse vsebine so dodane.' : `Manjka še ${steviloStrani(skupaj)}.`}</p>
          <ul class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
            {strani.map((s) => {
              const n = s.sekcije.reduce((m, x) => m + x.postavke.length, 0);
              return <li class="flex justify-between gap-3 border-b border-crna/10 py-1"><a href={`#stran-${s.ime}`} class="hover:underline">{s.ime}</a><span class="font-bold tabular-nums">{n}</span></li>;
            })}
          </ul>
        </div>

        {strani.map((s) => (
          <details id={`stran-${s.ime}`} class="stran group mt-4 rounded-lg border border-crna/20" open>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3">
              <span class="text-lg font-extrabold">{s.ime}</span>
              <span class="flex items-center gap-3 text-sm">
                <span class="rounded-full bg-zelena-temna px-2.5 py-0.5 font-bold text-bela tabular-nums">{s.sekcije.reduce((m, x) => m + x.postavke.length, 0)}</span>
                <span class="text-crna/50 transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
              </span>
            </summary>
            <div class="border-t border-crna/10 px-4 pb-4">
              {s.sekcije.map((sek) => (
                <div class="mt-4">
                  <h3 class="text-sm font-bold uppercase tracking-wide text-crna/60">{sek.ime}</h3>
                  <ul class="mt-2 space-y-2">
                    {sek.postavke.map((p) => (
                      <li class="flex gap-3">
                        <span class="mt-1 h-3.5 w-3.5 shrink-0 rounded-sm border-2 border-crna/40" aria-hidden="true"></span>
                        <div class="min-w-0">
                          <p class="leading-snug">{p.kaj}</p>
                          <p class="mt-0.5 text-sm text-crna/60">
                            {p.oblika && <span>{p.oblika} · </span>}
                            <a href={p.povezava} class="text-zelena-temna underline underline-offset-2" target="_blank" rel="noopener">poglej na strani ↗</a>
                          </p>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        ))}
        <p class="mt-4 text-xs text-crna/50">Iz istih podatkov kot <code>npm run check-placeholders</code> ({placeholderjev} oznak v datotekah) + kandidati brez fotografije.</p>
      </section>

      <!-- 2: maintained by hand -->
      <section id="odprte" class="mt-14">
        <h2 class="text-2xl font-extrabold tracking-tight">2. Odprte zadeve</h2>
        <p class="mt-1 text-sm text-crna/70">Odločitve in podatki, ki jih potrebujemo od ekipe.</p>
        <ul class="mt-4 space-y-3">
          {zadeve.map(({ data: z }) => (
            <li class:list={['rounded-lg border p-4', z.status === 'urejeno' ? 'border-crna/10 bg-neutral-100 text-crna/45' : 'border-crna/20']}>
              <div class="flex flex-wrap items-start justify-between gap-2">
                <p class:list={['font-extrabold leading-snug', z.status === 'urejeno' && 'line-through']}>{z.naslov}</p>
                <span class:list={[
                  'shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold',
                  z.status === 'odprto' && 'bg-rdeca text-bela',
                  z.status === 'v teku' && 'bg-krema text-crna',
                  z.status === 'urejeno' && 'bg-neutral-300 text-crna/60',
                ]}>{z.status}</span>
              </div>
              <p class="mt-1 text-[0.95rem] leading-relaxed">{z.opis}</p>
              {z.kdo && <p class="mt-1 text-sm font-bold">Kdo: {z.kdo}</p>}
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  .stran summary::-webkit-details-marker {
    display: none;
  }
</style>
