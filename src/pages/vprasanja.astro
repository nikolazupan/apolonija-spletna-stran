---
// Questions and answers: green band with the question form (UI only), then the answered
// questions as an accordion, newest first, each opened by a big hand-tilted "?".
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuestionForm from '../components/ui/QuestionForm.astro';
import Placeholder from '../components/Placeholder.astro';
import { getStran } from '../lib/strani';
import { formatDatum } from '../lib/objave';

const { naslov, opis, blok } = await getStran('vprasanja');
const uvod = blok('uvod');
const seznam = blok('seznam');
const razlika = blok('razlika');
const vprasanja = (await getCollection('vprasanja')).sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime());
const odgovori = await Promise.all(vprasanja.map(async (v) => ({ v, Content: (await render(v)).Content })));
const vprasanje = (uvod.naslov ?? '').replace(/\?$/, '');
---

<BaseLayout title={naslov} description={opis}>
  <section class="paper bg-zelena text-crna">
    <div class="site-container grid gap-8 py-10 lg:grid-cols-12 lg:items-center lg:gap-6 lg:py-16">
      <h1 class="display text-[clamp(2.75rem,10vw,5rem)] lg:col-span-5">
        <span class="block">{vprasanje}<span class="ml-[0.04em] inline-block origin-bottom-left rotate-12 scale-125 text-krema">?</span></span>
        <span class="block pl-[0.6em] text-krema">{uvod.besedilo}</span>
      </h1>
      <div class="lg:col-span-6 lg:col-start-7">
        <QuestionForm />
      </div>
    </div>
  </section>

  <section class="site-container py-12 lg:py-16" aria-labelledby="seznam">
    <h2 id="seznam" class="naslov-sekcije">{seznam.naslov}</h2>
    <p class="mt-3 max-w-prose text-base leading-relaxed">
      <Placeholder active={razlika.placeholder}>{razlika.besedilo}</Placeholder>
      <a href="/odprta-vprasanja" class="ml-1 whitespace-nowrap border-b-2 border-zelena font-bold hover:text-zelena-temna">Odprta vprašanja mesta →</a>
    </p>
    <div class="mt-8 max-w-4xl divide-y-2 divide-crna/15 border-y-2 border-crna">
      {odgovori.map(({ v, Content }, i) => (
        <details class="vprasanje group" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start gap-4 py-5 sm:gap-6">
            <span class="display w-10 shrink-0 text-5xl text-zelena transition-transform duration-300 group-open:rotate-12 sm:w-12 sm:text-6xl" aria-hidden="true">?</span>
            <span class="flex-1 pt-1">
              <span class="block text-xl font-extrabold leading-snug tracking-tight sm:text-2xl">
                <Placeholder active={v.data.placeholder}>{v.data.vprasanje}</Placeholder>
              </span>
              <time class="mt-1 block text-sm font-medium text-crna/70" datetime={v.data.datum.toISOString()}>{formatDatum(v.data.datum)}</time>
            </span>
            <svg viewBox="0 0 16 16" class="mt-3 h-4 w-4 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg>
          </summary>
          <div class="pb-6 pl-14 text-lg leading-relaxed sm:pl-[4.5rem]">
            <p class="text-sm font-bold uppercase tracking-wider text-zelena-temna">Odgovor Apolonije</p>
            <Placeholder active={v.data.placeholder} as="div" class="mt-2 block">
              <Content />
            </Placeholder>
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .vprasanje summary::-webkit-details-marker {
    display: none;
  }
</style>
