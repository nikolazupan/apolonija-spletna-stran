---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import AskQuestion from '../components/home/AskQuestion.astro';
import KeyPoints from '../components/home/KeyPoints.astro';
import HomeSkupaj from '../components/home/HomeSkupaj.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import { getObjave } from '../lib/objave';
import { getStran } from '../lib/strani';

const { naslov, opis, hero, poudarki, blok } = await getStran('vstopna');
const vprasanja = blok('vprasanja');
const poudarkiBlok = blok('poudarki');
const objavaBlok = blok('objava');
// programme areas selected in vstopna.md, in the listed order, with their shortened texts
const podrocja = await Promise.all(
  poudarki.map(async (p) => {
    const podrocje = await getEntry(p.podrocje);
    if (!podrocje) throw new Error(`vstopna.md: unknown programme area "${p.podrocje.id}"`);
    return { podrocje, besedilo: p.besedilo };
  }),
);
// newest post goes into the hero; the archive row shows the next ones, so nothing appears twice
const [najnovejsa, ...starejse] = await getObjave();
const objave = starejse.slice(0, 4);
---

<BaseLayout title={naslov} description={opis} fullTitle>
  {hero && <HomeHero hero={hero} objava={najnovejsa} oznakaObjave={blok('zadnjaObjava').besedilo} />}
  <AskQuestion naslov={[vprasanja.naslov ?? '', vprasanja.besedilo]} povezava="/vprasanja" povezavaBesedilo={vprasanja.povezava ?? ''} />
  <KeyPoints naslov={poudarkiBlok.naslov} povezavaBesedilo={poudarkiBlok.povezava} osnutek={poudarkiBlok.osnutek} podrocja={podrocja} />
  <HomeSkupaj kandidatura={blok('kandidatura')} poudarek={blok('kandidaturaPoudarek')} skupaj={blok('skupaj')} />
  {objave.length > 0 && <LatestPosts objave={objave} naslov={objavaBlok.naslov} povezavaArhiv={objavaBlok.povezava} />}
</BaseLayout>
