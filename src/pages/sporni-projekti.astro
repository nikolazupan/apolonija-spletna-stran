---
// Contested projects: each as a newspaper-style clipping (torn photo, short text) with
// "Naše stališče" as a rubber-stamp label above a paper note. Photo side alternates.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import PaperCard from '../components/ui/PaperCard.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import Placeholder from '../components/Placeholder.astro';
import { getStran } from '../lib/strani';
import { papirji } from '../lib/blob';

const { naslov, opis, blok } = await getStran('sporni-projekti');
const uvod = blok('uvod');
// stamp above each position, and the prefix of the link to the programme area
const stalisce = blok('stalisce');
const projekti = await Promise.all(
  (await getCollection('sporniProjekti'))
    .sort((a, b) => a.data.vrstniRed - b.data.vrstniRed)
    // programme area the position is quoted from
    .map(async (p) => ({ ...p, vir: p.data.stalisceVir ? await getEntry(p.data.stalisceVir) : undefined })),
);
// torn-paper edge for the photos
const raztrgano = 'polygon(0% 3%, 8% 0%, 19% 2%, 31% 0%, 44% 3%, 57% 0%, 69% 2%, 82% 0%, 93% 3%, 100% 1%, 99% 97%, 88% 100%, 76% 97%, 63% 100%, 50% 98%, 37% 100%, 24% 97%, 12% 100%, 0% 98%)';
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={uvod.naslov ?? naslov} uvod={uvod} oblika="i" />

  <section class="site-container space-y-16 pb-16 pt-4 lg:space-y-24 lg:pb-24" aria-label="Projekti">
    {projekti.map(({ id, data: p, vir }, i) => (
      <article id={id} class="grid scroll-mt-28 items-start gap-8 md:grid-cols-12 md:gap-10">
        <div class:list={['md:col-span-5', i % 2 ? 'md:order-2 md:col-start-8 rotate-1' : '-rotate-1']}>
          {p.slika ? (
            <Image src={p.slika} alt={p.naslov} widths={[400, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full object-cover" style={`clip-path:${raztrgano}`} />
          ) : (
            <div style={`clip-path:${raztrgano}`}>
              <ImagePlaceholder label={p.oznakaSlike ?? `FOTO: ${p.naslov}`} mark={false} class="aspect-[4/3] w-full" />
            </div>
          )}
        </div>

        <div class:list={['md:col-span-7', i % 2 ? 'md:order-1 md:col-start-1' : '']}>
          <p class="text-sm font-bold tabular-nums text-zelena-temna">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="naslov-sekcije mt-1"><Placeholder active={p.naslovOsnutek}>{p.naslov}</Placeholder></h2>
          <p class="mt-4 max-w-prose text-lg leading-relaxed"><Placeholder active={p.osnutek}>{p.opis}</Placeholder></p>

          <div class="mt-8">
            <p class="ml-4 inline-block -rotate-3 border-[3px] border-crna px-3 py-1 text-sm font-extrabold uppercase tracking-[0.12em]">{stalisce.naslov}</p>
            <PaperCard {...papirji[(i + 1) % papirji.length]} class="-mt-2">
              <p class="text-lg font-semibold leading-snug"><Placeholder active={p.stalisceOsnutek}>{p.stalisce}</Placeholder></p>
            </PaperCard>
            {vir && (
              <p class="mt-3 text-sm">
                {stalisce.povezava} <a href={`/program/${vir.id}`} class="border-b-2 border-zelena font-bold hover:text-zelena-temna">{vir.data.naslov} →</a>
              </p>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
