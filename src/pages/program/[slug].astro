---
// Program, level 3: one page per chapter. Number + title on a hand-cut shape, the leaflet measure as the lead,
// the broad version (markdown body), "Dodatna besedila" (published additional texts for this chapter,
// src/content/dodatna-besedila/), and navigation to the neighbouring chapters.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShapedText from '../../components/brand/ShapedText.astro';
import Risba from '../../components/brand/Risba.astro';
import Placeholder from '../../components/Placeholder.astro';
import PaperCard from '../../components/ui/PaperCard.astro';
import { getProgram, getDodatnaBesedila, povezavaDodatnega } from '../../lib/program';
import { getStran } from '../../lib/strani';
import { papirji } from '../../lib/blob';

export async function getStaticPaths() {
  const poglavja = await getProgram();
  return poglavja.map((p, i) => ({
    params: { slug: p.id },
    props: { poglavje: p, prejsnje: poglavja[i - 1], naslednje: poglavja[i + 1] },
  }));
}

const { poglavje, prejsnje, naslednje } = Astro.props;
const { naslov, ukrep, osnutek, vrstniRed } = poglavje.data;
const { Content } = await render(poglavje);
const { blok } = await getStran('program');
// back link, heading of the additional texts, line when there are none
const besedila = blok('poglavje');
const avtorOznaka = blok('dodatno').podpis;
const dodatna = await getDodatnaBesedila(poglavje.id);
---

<BaseLayout title={`${naslov} | Program`} description={`${naslov}: ${ukrep}`}>
  <section class="site-container pb-8 pt-6 lg:pt-10">
    <a href="/program" class="text-sm font-bold hover:text-zelena-temna">← {besedila.povezava}</a>
    <ShapedText variant={vrstniRed % 2 ? 'e' : 'b'} shapeClass="-rotate-1" class="mt-4 max-w-4xl">
        <span class="relative inline-flex h-16 w-16 items-center justify-center font-display text-4xl font-extrabold" aria-hidden="true">
          <Risba name="krog" class="absolute -inset-2 h-[calc(100%+1rem)] w-[calc(100%+1rem)] [--risba-w:4px]" />
          {vrstniRed}
        </span>
        <h1 class="display mt-5 text-[clamp(2.5rem,8vw,5rem)]">{naslov}</h1>
    </ShapedText>
  </section>

  <!-- leaflet measure -->
  <section class="site-container py-6">
    <p class="max-w-3xl text-xl font-semibold leading-snug text-zelena-temna sm:text-2xl">{ukrep}</p>
    <Risba name="podcrta" class="mt-3 h-2.5 w-40 [--risba-w:4px]" />
  </section>

  <section class="site-container grid gap-12 py-10 lg:grid-cols-12 lg:py-14">
    <!-- broad version -->
    <div class="lg:col-span-7">
      <Placeholder active={osnutek} as="div" class="block space-y-4 text-lg leading-relaxed">
        <Content />
      </Placeholder>
    </div>

    <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="dodatna">
      <h2 id="dodatna" class="text-xl font-extrabold tracking-tight">{besedila.naslov}</h2>
      {dodatna.length ? (
        <ul class="mt-4 space-y-4">
          {dodatna.map((b, i) => (
            <li>
              <PaperCard href={povezavaDodatnega(b)} {...papirji[(i + 2) % papirji.length]}>
                <p class="text-lg font-extrabold leading-tight tracking-tight">{b.data.naslov} →</p>
                {b.data.avtor && (
                  <p class="mt-1 text-sm">
                    {avtorOznaka} <Placeholder active={b.data.avtorOsnutek}>{b.data.avtor}</Placeholder>
                  </p>
                )}
              </PaperCard>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 border-t-2 border-crna pt-4 text-base">{besedila.besedilo}</p>
      )}
    </aside>
  </section>

  <nav class="site-container pb-16 text-base" aria-label="Druga poglavja">
  <div class="flex flex-wrap justify-between gap-4 border-t-2 border-crna/15 pt-8">
    {prejsnje ? <a href={`/program/${prejsnje.id}`} class="font-bold hover:text-zelena-temna">← {prejsnje.data.naslov}</a> : <span></span>}
    {naslednje && <a href={`/program/${naslednje.id}`} class="text-right font-bold hover:text-zelena-temna">{naslednje.data.naslov} →</a>}
  </div>
  </nav>
</BaseLayout>
