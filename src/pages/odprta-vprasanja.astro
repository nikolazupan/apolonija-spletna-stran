---
// "Odprta vprašanja mesta": the team's document on open issues in the city, kept exactly as written
// (src/content/odprta-vprasanja/). Title on a hand-cut shape, table of contents from the document's
// headings (sticky beside the text on desktop, collapsible on phones), comfortable reading width.
// Different from /vprasanja (citizens' questions with answers); each page says so in its intro line.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import Placeholder from '../components/Placeholder.astro';
import Risba from '../components/brand/Risba.astro';

const stran = await getEntry('odprtaVprasanja', 'odprta-vprasanja');
if (!stran) throw new Error('Missing src/content/odprta-vprasanja/odprta-vprasanja.md');
const { naslov, opis, uvod, uvodPovezava, uvodOsnutek, osnutek } = stran.data;
const { Content, headings } = await render(stran);
const poglavja = headings.filter((h) => h.depth === 3);
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={naslov} oblika="g">
    <p slot="deco" class="relative px-6 text-center font-display font-extrabold leading-none" aria-hidden="true">
      <span class="relative inline-flex h-36 w-36 items-center justify-center text-[4rem] tracking-[-0.04em] text-crna sm:h-40 sm:w-40 sm:text-[4.5rem]">
        {poglavja.length}
        <Risba name="krogSvincnik" rough={false} class="absolute inset-0 h-full w-full text-zelena" />
      </span>
      <span class="mt-3 block text-xl tracking-tight">odprtih vprašanj</span>
    </p>
  </PageIntro>

  <section class="site-container pb-16 lg:pb-24">
    <!-- intro line: what this page is, and where the citizens' questions are -->
    <p class="max-w-prose text-lg leading-relaxed">
      <Placeholder active={uvodOsnutek}>{uvod}</Placeholder>
      <a href="/vprasanja" class="ml-1 whitespace-nowrap border-b-2 border-zelena font-bold hover:text-zelena-temna">{uvodPovezava} →</a>
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- table of contents: collapsible on phones, sticky beside the text on desktop -->
      <nav class="lg:col-span-4 xl:col-span-3" aria-labelledby="kazalo">
        <details class="kazalo group border-2 border-crna bg-bela/60 lg:sticky lg:top-28 lg:border-0 lg:bg-transparent" open>
          <summary id="kazalo" class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-lg font-extrabold tracking-tight lg:pointer-events-none lg:px-0 lg:pt-0">
            Kazalo
            <svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform group-open:rotate-45 lg:hidden" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg>
          </summary>
          <ol class="space-y-1.5 border-t-2 border-crna/15 px-4 pb-4 pt-3 text-[0.95rem] leading-snug lg:max-h-[calc(100vh-9rem)] lg:overflow-y-auto lg:px-0">
            {poglavja.map((h) => (
              <li><a href={`#${h.slug}`} class="block hover:text-zelena-temna hover:underline">{h.text}</a></li>
            ))}
          </ol>
        </details>
      </nav>

      <!-- the document, exactly as written by the team -->
      <article class="lg:col-span-8 xl:col-span-7 xl:col-start-5">
        <Placeholder active={osnutek} as="div" class="vsebina block">
          <Content />
        </Placeholder>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .kazalo summary::-webkit-details-marker {
    display: none;
  }
  /* desktop: the table of contents is always open */
  @media (min-width: 1024px) {
    .kazalo:not([open]) > ol {
      display: block;
    }
  }

  /* long text: comfortable line length and clear structure */
  /* the text sits inside the Placeholder component, so these rules are global, scoped by .vsebina */
  :global(.vsebina) {
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }
  :global(.vsebina p) {
    margin-top: 1rem;
  }
  /* the document's own title line and intro paragraph */
  :global(.vsebina > p:first-of-type) {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-stretch: 85%;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  :global(.vsebina h3) {
    scroll-margin-top: 7rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-crna);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 85%;
    letter-spacing: -0.03em;
    line-height: 1.05;
    font-size: clamp(1.6rem, 4.5vw, 2.25rem);
  }
  :global(.vsebina h3 strong) {
    font-weight: inherit;
  }
  /* the four recurring labels ("Kaj je odprto:" …) as small green captions above their text */
  :global(.vsebina h3 ~ p > strong:first-child) {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-zelena-temna);
  }
</style>
