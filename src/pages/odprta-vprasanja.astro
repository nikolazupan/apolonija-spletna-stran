---
// "Odprta vprašanja mesta": open issues in the city, one entry per question (src/content/odprta-vprasanja/,
// text exactly as written). Title on a hand-cut shape with the number of questions, the document's intro, a numbered
// table of contents, then the questions. A question with a photo shows it as a tilted cut-out on a white paper
// backing beside the text (sides alternate; above the text on phones), with caption and photo credit in small text.
// Questions without a photo keep the same reading column. Page texts: src/content/strani/odprta-vprasanja.md.
// Different from /vprasanja (citizens' questions with answers); the intro links there.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import Placeholder from '../components/Placeholder.astro';
import Risba from '../components/brand/Risba.astro';
import Blob from '../components/brand/Blob.astro';
import CutoutImage from '../components/brand/CutoutImage.astro';
import BlockText from '../components/BlockText.astro';
import { getStran } from '../lib/strani';
import type { BlobVariant } from '../lib/blob';

const { naslov, opis, blok } = await getStran('odprta-vprasanja');
const uvod = blok('uvod');
const fotoOznaka = blok('slika').podpis;
const vprasanja = (await getCollection('odprtaVprasanja'))
  .sort((a, b) => a.data.vrstniRed - b.data.vrstniRed)
  // rendered text; the non-breaking space the source has after each opening label ("Kaj je odprto:")
  // becomes a normal one, so it doesn't indent the line under the label (display only, the text is unchanged)
  .map((v) => ({ id: v.id, ...v.data, html: (v.rendered?.html ?? '').replace(/(<p><strong>[^<]*<\/strong>)\u00a0/g, '$1 ') }));
// photo shapes and tilts, cycled
const oblike: { izrez: BlobVariant; podlaga: BlobVariant; nagib: string }[] = [
  { izrez: 'a', podlaga: 'f', nagib: 'rotate-2' },
  { izrez: 'c', podlaga: 'b', nagib: '-rotate-2' },
  { izrez: 'd', podlaga: 'e', nagib: 'rotate-1' },
  { izrez: 'b', podlaga: 'f', nagib: '-rotate-1' },
];
let s = 0; // photos so far: alternates the side
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={naslov} oblika="g">
    <p slot="deco" class="relative px-6 text-center font-display font-extrabold leading-none" aria-hidden="true">
      <span class="relative inline-flex h-36 w-36 items-center justify-center text-[4rem] tracking-[-0.04em] text-crna sm:h-40 sm:w-40 sm:text-[4.5rem]">
        {vprasanja.length}
        <Risba name="krogSvincnik" rough={false} class="absolute inset-0 h-full w-full text-zelena" />
      </span>
      <span class="mt-3 block text-xl tracking-tight">{blok('stevilo').besedilo}</span>
    </p>
  </PageIntro>

  <section class="site-container pb-10 lg:pb-14">
    <div class="max-w-3xl">
      {uvod.naslov && <h2 class="font-display text-[clamp(1.6rem,4vw,2.2rem)] font-extrabold leading-[1.05] tracking-[-0.03em] [font-stretch:85%]">{uvod.naslov}</h2>}
      <p class="mt-4 max-w-prose text-lg leading-relaxed">
        <Placeholder active={uvod.osnutek}>{uvod.besedilo}</Placeholder>
        {uvod.povezava && <a href="/vprasanja" class="ml-1 whitespace-nowrap border-b-2 border-zelena font-bold hover:text-zelena-temna">{uvod.povezava} →</a>}
      </p>
    </div>

    <!-- table of contents: numbered, in columns -->
    <nav class="mt-10" aria-labelledby="kazalo">
      <details class="kazalo group border-2 border-crna bg-bela/60" open>
        <summary id="kazalo" class="flex cursor-pointer list-none items-center justify-between px-5 py-3 text-lg font-extrabold tracking-tight">
          {blok('kazalo').naslov}
          <svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg>
        </summary>
        <ol class="grid gap-x-8 gap-y-1.5 border-t-2 border-crna/15 px-5 pb-5 pt-4 text-[0.95rem] leading-snug sm:grid-cols-2 lg:grid-cols-3">
          {vprasanja.map((v, i) => (
            <li class="flex gap-2">
              <span class="w-6 shrink-0 font-bold tabular-nums text-zelena-temna">{i + 1}.</span>
              <a href={`#${v.id}`} class="hover:text-zelena-temna hover:underline">{v.naslov}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  </section>

  <section class="site-container pb-16 lg:pb-24" aria-label="Odprta vprašanja">
    <ol class="space-y-14 lg:space-y-20">
      {vprasanja.map((v, i) => {
        const o = oblike[s % oblike.length];
        const desno = s % 2 === 0;
        if (v.slika) s++;
        return (
          <li id={v.id} class="scroll-mt-28 border-t-2 border-crna pt-6 lg:pt-8">
            <article class:list={['grid gap-6', v.slika && 'md:grid-cols-12 md:gap-10 lg:gap-14']}>
              <div class:list={[v.slika && 'md:col-span-7', v.slika && !desno && 'md:order-2']}>
                <span class="display block text-5xl text-zelena" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="mt-2 max-w-2xl font-display text-[clamp(1.6rem,4.5vw,2.4rem)] font-extrabold leading-[1.02] tracking-[-0.035em] [font-stretch:85%]">{v.naslov}</h2>
                <Placeholder active={v.osnutek} as="div" class="vprasanje-besedilo mt-5 block max-w-prose">
                  <Fragment set:html={v.html} />
                </Placeholder>
              </div>

              {v.slika && (
                <figure class:list={['max-md:order-first md:col-span-5 md:pt-16', !desno && 'md:order-1']}>
                  <div class="relative mx-auto w-[88%] max-w-md md:w-full">
                    <Blob variant={o.podlaga} fill="var(--color-bela)" class:list={['absolute -inset-[6%] h-[112%] w-[112%]', desno ? '-rotate-3' : 'rotate-3']} />
                    <CutoutImage
                      src={v.slika}
                      alt={v.opisSlike ?? ''}
                      variant={o.izrez}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 1344px) 34rem, (min-width: 768px) 38vw, 88vw"
                      class:list={['relative', o.nagib]}
                      imgClass="aspect-[4/3] object-cover"
                    />
                  </div>
                  {(v.opisSlike || v.avtorFotografije) && (
                    <figcaption class="mx-auto mt-6 w-[88%] max-w-md text-xs leading-snug text-crna/75 md:w-full">
                      {v.opisSlike}
                      {v.opisSlike && v.avtorFotografije && ' · '}
                      {v.avtorFotografije && <span class="whitespace-nowrap">{fotoOznaka} {v.avtorFotografije}</span>}
                    </figcaption>
                  )}
                </figure>
              )}
            </article>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>

<style>
  .kazalo summary::-webkit-details-marker {
    display: none;
  }

  /* the text of a question (rendered markdown, so the rules are global, scoped by .vprasanje-besedilo) */
  :global(.vprasanje-besedilo) {
    font-size: 1.125rem;
    line-height: 1.7;
  }
  :global(.vprasanje-besedilo p + p) {
    margin-top: 1rem;
  }
  /* the recurring labels ("Kaj je odprto:" …) as small green captions above their text */
  :global(.vprasanje-besedilo p > strong:first-child) {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-zelena-temna);
  }
</style>
