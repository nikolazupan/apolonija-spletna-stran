---
// Donations: request text, payment details on a hand-cut "payment slip" with copy buttons,
// and a link to the donation page of Vesna.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import PaperCard from '../components/ui/PaperCard.astro';
import Placeholder from '../components/Placeholder.astro';
import BlockText from '../components/BlockText.astro';
import TextLink from '../components/ui/TextLink.astro';
import Risba from '../components/brand/Risba.astro';
import { getStran } from '../lib/strani';

const { naslov, opis, blok, podatki, povezave } = await getStran('pomagaj');
const nakazilo = blok('nakazilo');
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={naslov} uvod={blok('uvod')} oblika="i" nagib="rotate-1">
    <p slot="deco" class="relative px-6 py-4 text-center font-display text-[5rem] font-extrabold leading-none text-zelena" aria-hidden="true">
      €
      <Risba name="krog" class="absolute inset-0 h-full w-full [--risba-w:4px]" />
    </p>
  </PageIntro>

  <section class="site-container grid gap-10 pb-16 pt-4 lg:grid-cols-12 lg:pb-24">
    <div class="lg:col-span-7">
      <h2 class="naslov-sekcije">{nakazilo.naslov}</h2>
      <BlockText blok={nakazilo} class="mt-3 max-w-prose text-lg leading-relaxed" />

      <!-- payment slip: dashed cut line on top, like a form to cut out -->
      <PaperCard oblika="g" nagib="-0.5deg" class="mt-8">
        <div class="px-6 pb-8 pt-6 sm:px-10">
          <p class="flex items-center gap-2 border-b-2 border-dashed border-crna/40 pb-3 text-xs font-bold uppercase tracking-[0.15em] text-crna/70">
            <span aria-hidden="true">✂</span> Podatki za nakazilo
          </p>
          <dl class="mt-4 divide-y divide-crna/10">
            {podatki.map((p) => (
              <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr_auto] sm:items-center sm:gap-4">
                <dt class="text-sm font-bold uppercase tracking-wide text-zelena-temna">{p.oznaka}</dt>
                <dd class="font-mono text-lg font-semibold tracking-wide">
                  <Placeholder active={p.placeholder}><span data-kopiraj-vrednost>{p.vrednost}</span></Placeholder>
                </dd>
                <dd>
                  <button type="button" data-kopiraj class="rounded-full border-2 border-crna px-3 py-1 text-xs font-bold hover:bg-crna hover:text-krema">Kopiraj</button>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </PaperCard>
    </div>

    <aside class="lg:col-span-4 lg:col-start-9 lg:pt-20">
      <div class="border-2 border-crna p-6">
        <h2 class="text-xl font-extrabold tracking-tight">Raje prek spleta?</h2>
        <p class="mt-2 text-base leading-relaxed">Doniraš lahko tudi prek spletne strani Vesne – zelene stranke.</p>
        <div class="mt-4 text-lg">
          {povezave.map((l) => <TextLink href={l.url} placeholder={l.placeholder}>{l.naslov}</TextLink>)}
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  // Copy a payment detail to the clipboard and confirm on the button.
  document.querySelectorAll<HTMLButtonElement>('[data-kopiraj]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.closest('div')?.querySelector('[data-kopiraj-vrednost]')?.textContent?.trim();
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Kopirano';
      } catch {
        btn.textContent = 'Ni uspelo';
      }
      setTimeout(() => (btn.textContent = 'Kopiraj'), 2000);
    });
  });
</script>
