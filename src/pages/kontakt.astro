---
// Contact: details on a hand-cut "postcard" with a stamp (partner logo), links and social profiles beside it.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import PaperCard from '../components/ui/PaperCard.astro';
import VesnaLogo from '../components/brand/VesnaLogo.astro';
import Placeholder from '../components/Placeholder.astro';
import TextLink from '../components/ui/TextLink.astro';
import { getStran } from '../lib/strani';
import { social } from '../data/site';

const { naslov, opis, blok, podatki, povezave } = await getStran('kontakt');
const uvod = blok('uvod');
const vprasanje = blok('vprasanje');
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={naslov} uvod={uvod} oblika="g" />

  <section class="site-container grid gap-10 pb-16 pt-4 lg:grid-cols-12 lg:pb-24">
    <PaperCard oblika="h" nagib="-1deg" class="lg:col-span-7">
      <div class="grid gap-6 sm:grid-cols-[1fr_auto]">
        <dl class="space-y-5">
          {podatki.map((p) => (
            <div>
              <dt class="text-sm font-bold uppercase tracking-wide text-zelena-temna">{p.oznaka}</dt>
              <dd class="mt-1 text-xl font-semibold">
                <Placeholder active={p.osnutek}>
                  {p.povezava ? <a href={p.povezava} class="underline underline-offset-4 hover:text-zelena-temna">{p.vrednost}</a> : p.vrednost}
                </Placeholder>
              </dd>
            </div>
          ))}
        </dl>
        <!-- postcard stamp -->
        <div class="order-first h-fit w-fit rotate-3 border-2 border-dashed border-zelena p-3 sm:order-none" aria-hidden="true">
          <VesnaLogo layout="stack" class="text-[0.55rem]" />
        </div>
      </div>
    </PaperCard>

    <div class="space-y-8 lg:col-span-4 lg:col-start-9 lg:pt-6">
      <div>
        <h2 class="text-xl font-extrabold tracking-tight">{blok('spletneStrani').naslov}</h2>
        <ul class="mt-3 space-y-2 text-lg">
          {povezave.map((l) => <li><TextLink href={l.url} osnutek={l.osnutek}>{l.naslov}</TextLink></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-extrabold tracking-tight">{blok('omrezja').naslov}</h2>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-lg">
          {social.map((s) => <li><TextLink href={s.href} osnutek={s.osnutek}>{s.label}</TextLink></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-extrabold tracking-tight">{vprasanje.naslov}</h2>
        <p class="mt-2 text-lg"><TextLink href="/vprasanja">{vprasanje.povezava}</TextLink></p>
      </div>
    </div>
  </section>
</BaseLayout>
