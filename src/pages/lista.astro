---
// The list: intro with the circled ballot number 9 and group photos, city council candidates as a poster mosaic
// (ballot order, list leader first and larger; name, part of the list, professional title, photo),
// then collapsible lists per četrtna skupnost.
// Data: src/content/kandidati/ (generated from the team's spreadsheet; only public fields).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import Risba from '../components/brand/Risba.astro';
import Blob from '../components/brand/Blob.astro';
import BlockText from '../components/BlockText.astro';
import { getStran } from '../lib/strani';
import type { ImageMetadata } from 'astro';

// portraits by candidate id: src/assets/fotografije/kandidati/<id>.jpg
const portreti = import.meta.glob<ImageMetadata>('../assets/fotografije/kandidati/*.jpg', { eager: true, import: 'default' });
const portret = (id: string) => portreti[`../assets/fotografije/kandidati/${id}.jpg`];

const { naslov, opis, blok, fotografije } = await getStran('lista');
const mestniSvet = blok('mestniSvet');
const nosilec = blok('nosilec').besedilo;
// group photos: large one, smaller one overlapping it
const [skupinska, vodilni] = fotografije;
const cetrtne = blok('cetrtne');
const kandidati = (await getCollection('kandidati')).sort((a, b) => a.data.vrstniRed - b.data.vrstniRed);
const skupnosti = (await getCollection('cetrtneSkupnosti')).sort((a, b) => a.data.vrstniRed - b.data.vrstniRed);
// initials for candidates without a photo (first and last name, titles left out)
const inicialke = (ime: string) => {
  const deli = ime.replace(/^(mag|dr)\.\s+/, '').split(/\s+/);
  return (deli[0][0] + (deli.length > 1 ? deli[deli.length - 1][0] : '')).toUpperCase();
};
// Slovenian plural: 1 kandidat, 2 kandidata, 3–4 kandidati, 5+ kandidatov
const kandidatov = (n: number) => `${n} ${n % 100 === 1 ? 'kandidat' : n % 100 === 2 ? 'kandidata' : n % 100 === 3 || n % 100 === 4 ? 'kandidati' : 'kandidatov'}`;
const tilt = ['-rotate-1', 'rotate-1', 'rotate-[0.5deg]', '-rotate-[0.5deg]', 'rotate-[1.5deg]'];
---

<BaseLayout title={naslov} description={opis}>
  <PageIntro naslov={naslov} uvod={blok('uvod')} oblika="h">
    <div slot="deco" class="flex items-center gap-5">
      <span class="relative inline-flex h-24 w-24 items-center justify-center font-display text-7xl font-extrabold sm:h-32 sm:w-32 sm:text-8xl" aria-hidden="true">
        <Risba name="krog" class="absolute -inset-3 h-[calc(100%+1.5rem)] w-[calc(100%+1.5rem)] [--risba-w:5px]" />
        9
      </span>
      <p class="max-w-[9rem] text-sm font-bold uppercase leading-tight tracking-wide">{mestniSvet.besedilo}</p>
    </div>
  </PageIntro>

  <!-- group photos, pinned like prints -->
  <section class="site-container pb-6 pt-2" aria-label="Skupinski fotografiji">
    <div class="grid items-end gap-6 md:grid-cols-12 md:gap-4">
      <div class="-rotate-1 border-[8px] border-bela bg-bela md:col-span-7 md:row-start-1">
        {skupinska?.slika && <Image src={skupinska.slika} alt={skupinska.alt ?? ''} widths={[600, 1000, 1400]} sizes="(min-width: 768px) 60vw, 100vw" class="aspect-[3/2] w-full object-cover" />}
      </div>
      <div class="relative z-10 mx-auto w-[80%] rotate-2 border-[8px] border-bela bg-bela md:col-span-5 md:col-start-8 md:row-start-1 md:ml-6 md:w-auto md:translate-y-6">
        {vodilni?.slika && <Image src={vodilni.slika} alt={vodilni.alt ?? ''} widths={[400, 700]} sizes="(min-width: 768px) 38vw, 80vw" class="aspect-[3/2] w-full object-cover" />}
      </div>
    </div>
  </section>

  <!-- city council: mosaic in ballot order -->
  <section class="site-container py-10 lg:py-14" aria-labelledby="mestni-svet">
    <h2 id="mestni-svet" class="naslov-sekcije">{mestniSvet.naslov}</h2>
    <ol class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {kandidati.map(({ id, data: k }, i) => {
        const slika = k.slika ?? portret(id);
        return (
        <li class:list={[k.nosilec && 'col-span-2 row-span-2']}>
          <article class:list={['flex h-full flex-col border-[6px] border-bela bg-bela', tilt[i % tilt.length]]}>
            <!-- photo, or (no photo yet) the initials on a hand-cut shape -->
            <div class="relative">
              {slika ? (
                <Image src={slika} alt={k.ime} widths={[300, 600]} sizes="(min-width: 1024px) 18vw, 46vw" class="aspect-square w-full object-cover object-[50%_22%]" />
              ) : (
                <div class="paper flex aspect-square w-full items-center justify-center bg-krema" role="img" aria-label={`${k.ime} (fotografija še ni na voljo)`}>
                  <span class="relative flex aspect-square w-[58%] items-center justify-center">
                    <Blob variant={(['a', 'b', 'c'] as const)[i % 3]} fill="var(--color-zelena)" class="absolute inset-0 h-full w-full" />
                    <span class:list={['relative font-display font-extrabold tracking-tight text-bela', k.nosilec ? 'text-7xl' : 'text-4xl']} aria-hidden="true">{inicialke(k.ime)}</span>
                  </span>
                </div>
              )}
              <span class="absolute left-2 top-2 inline-flex h-9 min-w-9 items-center justify-center rounded-full bg-crna px-2 text-sm font-extrabold text-krema">{k.vrstniRed}</span>
            </div>
            <div class="flex flex-1 flex-col px-1 pb-1 pt-3">
              {k.nosilec && <p class="text-xs font-extrabold uppercase tracking-wider text-zelena-temna">{nosilec}</p>}
              <h3 class:list={['font-extrabold leading-tight tracking-tight', k.nosilec ? 'text-2xl sm:text-3xl' : 'text-base']}>{k.ime}</h3>
              <p class="mt-1.5">
                <span class:list={['inline-block rounded-full px-2 py-0.5 text-[0.68rem] font-bold leading-tight', k.clan === 'Vesna' ? 'bg-zelena-temna text-bela' : 'border-[1.5px] border-crna text-crna']}>{k.clan}</span>
              </p>
              <p class:list={['mt-1.5 leading-snug text-crna/80', k.nosilec ? 'text-base' : 'text-sm']}>{k.naziv}</p>
            </div>
          </article>
        </li>
        );
      })}
    </ol>
  </section>

  <!-- četrtne skupnosti: one collapsible list per skupnost -->
  <section class="site-container pb-16 pt-6 lg:pb-20" aria-labelledby="cetrtne">
    <h2 id="cetrtne" class="naslov-sekcije">{cetrtne.naslov}</h2>
    <BlockText blok={cetrtne} class="mt-4 max-w-prose text-lg leading-relaxed" />
    <div class="mt-8">
      <div class="grid items-start gap-3 md:grid-cols-2 md:gap-4">
        {skupnosti.map(({ data: s }) => (
          <details class="skupnost group border-2 border-crna bg-bela/60 open:bg-bela">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-lg font-extrabold tracking-tight">
              <span>ČS {s.ime}</span>
              <span class="flex items-center gap-3 text-sm font-bold">
                <span class="text-zelena-temna">{kandidatov(s.kandidati.length)}</span>
                <svg viewBox="0 0 16 16" class="h-4 w-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12" /></svg>
              </span>
            </summary>
            <ol class="grid list-inside list-decimal gap-x-6 gap-y-1 border-t-2 border-crna/15 px-5 py-4 text-base sm:grid-cols-2">
              {s.kandidati.map((ime) => <li>{ime}</li>)}
            </ol>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .skupnost summary::-webkit-details-marker {
    display: none;
  }
</style>
