---
// Apolonija Simon: name, photo collage (like photos pinned in a sketchbook), her own words, longer text, links.
import BaseLayout from '../layouts/BaseLayout.astro';
import CandidateMark from '../components/brand/CandidateMark.astro';
import CutoutImage from '../components/brand/CutoutImage.astro';
import Blob from '../components/brand/Blob.astro';
import Risba from '../components/brand/Risba.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import BlockText from '../components/BlockText.astro';
import TextLink from '../components/ui/TextLink.astro';
import { getStran } from '../lib/strani';
import type { BlobVariant } from '../lib/blob';

const { naslov, opis, blok, citati, fotografije, povezave } = await getStran('apolonija-simon');
const uvod = blok('uvod');
const [glavni, ...ostali] = citati;

// Collage positions: each photo its own cut-out shape and tilt.
const kolaz: { oblika: BlobVariant; nagib: string; razmerje: string }[] = [
  { oblika: 'c', nagib: '-rotate-3', razmerje: 'aspect-[4/5]' },
  { oblika: 'd', nagib: 'rotate-2', razmerje: 'aspect-[4/5]' },
  { oblika: 'f', nagib: 'rotate-1', razmerje: 'aspect-square' },
  { oblika: 'b', nagib: '-rotate-2', razmerje: 'aspect-square' },
];
---

<BaseLayout title={naslov} description={opis}>
  <!-- name + facts -->
  <section class="site-container pb-6 pt-6 lg:pt-10">
    <div class="relative max-w-4xl">
      <Blob variant="e" fill="var(--color-bela)" class="absolute inset-0 h-full w-full -rotate-1" />
      <div class="relative px-6 py-10 sm:px-12 sm:py-14">
        <CandidateMark as="h1" tagline="" class="text-[clamp(3.25rem,13vw,7rem)]" />
        <h2 class="mt-6 max-w-xl text-2xl font-extrabold leading-tight tracking-tight text-zelena-temna sm:text-3xl">{uvod.naslov}</h2>
        <BlockText blok={uvod} class="mt-3 max-w-xl text-lg leading-relaxed" />
      </div>
    </div>
  </section>

  <!-- photo collage -->
  <section class="site-container py-8 lg:py-12" aria-label="Fotografije">
    <ul class="grid grid-cols-2 items-center gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-8">
      {fotografije.map((f, i) => {
        const k = kolaz[i % kolaz.length];
        return (
          <li class:list={[k.nagib, i % 2 === 1 && 'md:translate-y-10']}>
            {f.slika ? (
              <CutoutImage src={f.slika} alt={f.alt ?? ''} variant={k.oblika} widths={[300, 600]} sizes="(min-width: 768px) 22vw, 46vw" imgClass={k.razmerje} />
            ) : (
              <ImagePlaceholder label={f.oznaka ?? 'FOTO'} class={`${k.razmerje} w-full rounded-[38%_42%_36%_44%/40%_36%_44%_38%]`} />
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <!-- her own words -->
  {glavni && (
    <section class="paper bg-zelena py-14 lg:py-20">
      <div class="site-container">
        <figure class="max-w-4xl">
          <blockquote class="display text-[clamp(2rem,6vw,3.75rem)] text-krema">
            <span class="text-crna">»</span>{glavni.besedilo}<span class="text-crna">«</span>
          </blockquote>
          <Risba name="podcrta" color="var(--color-crna)" class="mt-4 h-3 w-48 [--risba-w:4px]" />
          <figcaption class="mt-3 text-sm font-bold">
            Apolonija Simon, {glavni.url ? <a href={glavni.url} target="_blank" rel="noopener" class="underline underline-offset-2">{glavni.vir} ↗</a> : glavni.vir}
          </figcaption>
        </figure>

        {ostali.length > 0 && (
          <div class="mt-12 grid gap-6 md:grid-cols-3">
            {ostali.map((c) => (
              <figure class="border-t-2 border-crna pt-4">
                <blockquote class="text-lg font-medium leading-snug">»{c.besedilo}«</blockquote>
                <figcaption class="mt-2 text-sm font-bold">
                  {c.url ? <a href={c.url} target="_blank" rel="noopener" class="underline underline-offset-2">{c.vir} ↗</a> : c.vir}
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- longer text -->
  <section class="site-container grid gap-10 py-14 md:grid-cols-2 lg:gap-16 lg:py-20">
    {['zgodba', 'zakaj'].map((id) => {
      const b = blok(id);
      return (
        <article>
          <h2 class="naslov-sekcije">{b.naslov}</h2>
          <BlockText blok={b} class="mt-4 max-w-prose text-lg leading-relaxed" />
        </article>
      );
    })}
  </section>

  <section class="site-container flex flex-wrap gap-x-8 gap-y-3 pb-16 text-lg">
    {povezave.map((p) => <TextLink href={p.url} placeholder={p.placeholder}>{p.naslov}</TextLink>)}
    <TextLink href="/program">Program</TextLink>
    <TextLink href="/vprasanja">Vprašaj Apolonijo</TextLink>
  </section>
</BaseLayout>
