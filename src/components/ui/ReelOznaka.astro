---
// Play icon over a post's cover image (reels and videos only; no type tag, removed 2026-11-10).
// `vedno`: always rendered (hidden when the post is not a video), so the live feed can switch it on
// (src/lib/objave-v-zivo.ts → nastaviReel).
import { jeVideo } from '../../lib/objave';

interface Props {
  tip: string;
  vedno?: boolean;
}
const { tip, vedno = false } = Astro.props;
const video = jeVideo(tip);
---

{(video || vedno) && (
  <span data-o="reel" hidden={!video}>
    <span class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center" aria-hidden="true">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-crna/85 text-krema">
        <svg viewBox="0 0 20 20" class="ml-0.5 h-5 w-5" fill="currentColor"><path d="M5 3.5v13l11-6.5z" /></svg>
      </span>
    </span>
  </span>
)}
