---
// Content of a program chapter card: number, chapter title, leaflet measure, "Več" link label.
import type { CollectionEntry } from 'astro:content';
import { getStran } from '../../lib/strani';

interface Props {
  poglavje: CollectionEntry<'program'>;
}
const { poglavje } = Astro.props;
const { naslov, ukrep, vrstniRed } = poglavje.data;
// link label, from src/content/strani/program.md → bloki.kartica
const vec = (await getStran('program')).blok('kartica').povezava;
---

<div class="flex h-full flex-col items-center gap-2.5 px-1 text-center">
  <span class="display text-4xl text-zelena sm:text-5xl">{String(vrstniRed).padStart(2, '0')}</span>
  <h3 class="text-xl font-extrabold leading-tight tracking-tight">{naslov}</h3>
  <p class="text-[0.95rem] leading-snug">{ukrep}</p>
  {vec && <span class="mt-auto pt-2 text-sm font-bold group-hover:text-zelena-temna">{vec} →</span>}
</div>
