---
// Question form for Apolonija, sent through Web3Forms (key: PUBLIC_WEB3FORMS_KEY in .env / host build settings).
// Arrow submit button sits inside the field's bottom-right corner. Use once per page.
// Texts: src/content/strani/vprasanja.md → bloki.obrazec (naslov = hint in the empty field,
// besedilo = line under the field, podpis = message after sending) and bloki.obrazecNapaka (besedilo = error).
import Placeholder from '../Placeholder.astro';
import { getStran } from '../../lib/strani';

interface Props {
  // Subject of the email Web3Forms sends, so the team can tell where the question came from.
  zadeva: string;
}
const { zadeva } = Astro.props;

const stran = await getStran('vprasanja');
const obrazec = stran.blok('obrazec');
const napaka = stran.blok('obrazecNapaka');
const kljuc = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<Placeholder active={obrazec.osnutek} as="div" class="block">
  <form data-vprasanje action="https://api.web3forms.com/submit" method="POST" class="relative">
    <input type="hidden" name="access_key" value={kljuc} />
    <input type="hidden" name="subject" value={zadeva} />
    <!-- Honeypot: hidden from people, bots fill it and Web3Forms drops the submission. -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />
    <label for="vprasanje" class="sr-only">Tvoje vprašanje</label>
    <textarea
      id="vprasanje"
      name="vprasanje"
      rows="3"
      required
      class="block w-full resize-y rounded-2xl border-2 border-crna bg-krema py-3 pl-4 pr-16 text-lg placeholder:text-crna/55 focus:outline-none focus:ring-4 focus:ring-crna/30"
      placeholder={obrazec.naslov}
    ></textarea>
    <button
      type="submit"
      class="absolute bottom-3 right-3 flex h-11 w-11 items-center justify-center rounded-full bg-crna text-krema transition-colors hover:bg-zelena-temna focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-crna"
      aria-label="Pošlji vprašanje"
      title="Pošlji vprašanje"
    >
      <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 10h12M11 5l5 5-5 5" />
      </svg>
    </button>
  </form>
  <p
    class="mt-2 text-sm font-medium"
    role="status"
    data-vprasanje-status
    data-poslano={obrazec.podpis}
    data-napaka={napaka.besedilo}
  >{obrazec.besedilo}</p>
</Placeholder>

<script>
  // Send without leaving the page; without JS the form posts to Web3Forms directly.
  document.querySelectorAll<HTMLFormElement>('[data-vprasanje]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('[data-vprasanje-status]');
    const gumb = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const sporoci = (besedilo?: string) => {
      if (status && besedilo) status.textContent = besedilo;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      if (gumb) gumb.disabled = true;
      form.setAttribute('aria-busy', 'true');
      try {
        const odziv = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const podatki = await odziv.json().catch(() => ({}));
        if (!odziv.ok || !podatki.success) throw new Error(podatki.message || `HTTP ${odziv.status}`);
        form.reset();
        sporoci(status?.dataset.poslano);
      } catch (napaka) {
        console.error('Web3Forms:', napaka);
        sporoci(status?.dataset.napaka);
      } finally {
        if (gumb) gumb.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>
