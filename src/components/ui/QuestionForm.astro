---
// Question form for Apolonija (UI only, no backend yet): marked OSNUTEK and says so on submit.
// Arrow submit button sits inside the field's bottom-right corner. Use once per page.
// Texts: src/content/strani/vprasanja.md → bloki.obrazec (naslov = hint in the empty field,
// besedilo = line under the field, podpis = message after sending).
import Placeholder from '../Placeholder.astro';
import { getStran } from '../../lib/strani';

const obrazec = (await getStran('vprasanja')).blok('obrazec');
---

<Placeholder active={obrazec.osnutek} as="div" class="block">
  <form data-vprasanje class="relative" novalidate>
    <label for="vprasanje" class="sr-only">Tvoje vprašanje</label>
    <textarea
      id="vprasanje"
      name="vprasanje"
      rows="3"
      required
      class="block w-full resize-y rounded-2xl border-2 border-crna bg-krema py-3 pl-4 pr-16 text-lg placeholder:text-crna/55 focus:outline-none focus:ring-4 focus:ring-crna/30"
      placeholder={obrazec.naslov}
    ></textarea>
    <button
      type="submit"
      class="absolute bottom-3 right-3 flex h-11 w-11 items-center justify-center rounded-full bg-crna text-krema transition-colors hover:bg-zelena-temna focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-crna"
      aria-label="Pošlji vprašanje"
      title="Pošlji vprašanje"
    >
      <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 10h12M11 5l5 5-5 5" />
      </svg>
    </button>
  </form>
  <p class="mt-2 text-sm font-medium" role="status" data-vprasanje-status data-poslano={obrazec.podpis}>{obrazec.besedilo}</p>
</Placeholder>

<script>
  // No backend yet: keep the user on the page and say so.
  document.querySelectorAll<HTMLFormElement>('[data-vprasanje]').forEach((form) => {
    const status = form.parentElement?.querySelector('[data-vprasanje-status]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (status instanceof HTMLElement && status.dataset.poslano) status.textContent = status.dataset.poslano;
    });
  });
</script>
