---
// Instagram icon + the campaign's handle (from src/data/site.ts; OSNUTEK while it is a placeholder).
import Placeholder from '../Placeholder.astro';
import { instagramProfil } from '../../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-1.5 text-[0.7rem] font-bold leading-none', className]}>
  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none" />
  </svg>
  <Placeholder active={instagramProfil.placeholder}>{instagramProfil.handle}</Placeholder>
</span>
