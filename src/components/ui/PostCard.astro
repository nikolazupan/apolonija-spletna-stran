---
// One social media post as a white "print" card: thumbnail with type tag, date, caption, link.
// Photos/graphics: click-to-load (the Instagram embed loads only after a click; no Meta scripts on page load).
// Reels/videos: cover image + play icon + "Reel"/"Video"; a click opens the post on Instagram.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ImagePlaceholder from '../ImagePlaceholder.astro';
import Placeholder from '../Placeholder.astro';
import { formatDatum, tipOznaka, embedUrl, povezavaObjave, slikaObjave, jeVideo } from '../../lib/objave';
import ReelOznaka from './ReelOznaka.astro';

interface Props {
  objava: CollectionEntry<'objave'>;
  class?: string;
  sizes?: string;
}
const { objava, class: className, sizes = '(min-width: 1024px) 18vw, (min-width: 640px) 30vw, 46vw' } = Astro.props;
const o = objava.data;
const embed = embedUrl(o.povezava, o.platforma);
const slika = slikaObjave(o);
const video = jeVideo(o.tip);
const platforma = o.platforma === 'instagram' ? 'Instagramu' : 'Facebooku';
---

<!-- One format for every post type: square thumbnail (type tag in the corner), date, 2-line caption, link.
     Every Instagram post has an image (text posts too), so `slika` is the thumbnail for all types. -->
<article class:list={['flex h-full flex-col border-[6px] border-bela bg-bela', className]}>
  <div class="objava-medij relative aspect-square overflow-hidden bg-neutral-200" data-embed={embed ?? ''}>
    {slika ? (
      <Image src={slika} alt={o.opis} widths={[300, 600]} sizes={sizes} inferSize={typeof slika === 'string'} class="h-full w-full object-cover" />
    ) : (
      <ImagePlaceholder label="OBJAVA" class="h-full w-full items-end pb-3 text-xs" />
    )}
    {!video && (
      <span class="pointer-events-none absolute right-2 top-2 z-10 rounded-full bg-krema px-2 py-0.5 text-xs font-bold text-zelena-temna">{tipOznaka[o.tip]}</span>
    )}
    <ReelOznaka tip={o.tip} polozaj="desno" />

    <!-- reels/videos: the thumbnail opens the post on Instagram; others: click-to-load embed -->
    {video ? (
      <a href={povezavaObjave(o)} target="_blank" rel="noopener" class="absolute inset-0" aria-label={`${tipOznaka[o.tip]} na ${platforma}, ${formatDatum(o.datum)}: odpri na ${platforma}`}></a>
    ) : (
      <button type="button" class="objava-nalozi absolute inset-0" aria-label={`Naloži objavo z ${platforma} (${tipOznaka[o.tip]}, ${formatDatum(o.datum)})`}></button>
    )}
  </div>

  <div class="flex flex-1 flex-col px-1 pb-1 pt-3">
    <time class="whitespace-nowrap text-[0.8rem] font-bold sm:text-sm" datetime={o.datum.toISOString()}>{formatDatum(o.datum)}</time>
    <!-- always two lines high, so cards line up whatever the caption length -->
    <p class="mt-1.5 line-clamp-2 min-h-[2lh] text-sm leading-snug"><Placeholder active={o.placeholder}>{o.opis}</Placeholder></p>
    <a href={povezavaObjave(o)} target="_blank" rel="noopener" class="mt-auto pt-2 text-xs font-bold underline underline-offset-2 hover:text-zelena-temna">Odpri na {platforma} ↗</a>
  </div>
</article>

<script>
  // Replace the thumbnail with the embed only after a click (no third-party requests before that).
  document.querySelectorAll<HTMLButtonElement>('.objava-nalozi').forEach((btn) => {
    btn.addEventListener('click', () => {
      const box = btn.closest<HTMLElement>('.objava-medij');
      if (!box) return;
      const url = box.dataset.embed;
      if (!url) {
        box.insertAdjacentHTML(
          'beforeend',
          '<p class="absolute inset-x-2 bottom-2 rounded bg-crna px-2 py-1 text-xs font-medium text-krema">Prototip: tu se bo ob kliku naložila objava.</p>',
        );
        btn.remove();
        return;
      }
      const frame = document.createElement('iframe');
      frame.src = url;
      frame.title = btn.getAttribute('aria-label') ?? 'Objava';
      frame.loading = 'lazy';
      frame.allowFullscreen = true;
      frame.className = 'absolute inset-0 h-full w-full border-0 bg-bela';
      box.replaceChildren(frame);
    });
  });
</script>
