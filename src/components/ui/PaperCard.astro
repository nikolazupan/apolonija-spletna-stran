---
// Hand-cut white paper card: irregular shape behind the content, slight resting tilt,
// small wobble of the paper on hover/focus (none with reduced motion). Renders a link when `href` is set.
import ShapedText from '../brand/ShapedText.astro';
import type { BlobVariant } from '../../lib/blob';

interface Props {
  href?: string;
  oblika?: BlobVariant;
  // resting tilt, e.g. "-1.5deg"
  nagib?: string;
  // mirror the shape, for more variety from the same outlines
  zrcali?: boolean;
  fill?: string;
  class?: string;
}
const { href, oblika = 'g', nagib = '0deg', zrcali = false, fill = 'var(--color-bela)', class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['papir group relative block', href && 'papir-link', className]} style={`--nagib:${nagib};--zrcali:${zrcali ? -1 : 1}`}>
  <ShapedText variant={oblika} fill={fill} shapeClass="papir-oblika"><slot /></ShapedText>
</Tag>

<style>
  /* the shape is rendered by a child component (ShapedText → Blob), so target it with :global() */
  .papir :global(.papir-oblika) {
    transform: rotate(var(--nagib)) scaleX(var(--zrcali));
    transform-origin: 50% 60%;
  }
  .papir-link:hover :global(.papir-oblika),
  .papir-link:focus-visible :global(.papir-oblika) {
    animation: papir-wobble 0.55s ease-in-out;
  }
  .papir-link:focus-visible {
    outline: none;
  }
  .papir-link:focus-visible :global(.papir-oblika path) {
    stroke: var(--color-crna);
    stroke-width: 2.5px;
    vector-effect: non-scaling-stroke;
  }
  @keyframes papir-wobble {
    0% { transform: rotate(var(--nagib)) scaleX(var(--zrcali)); }
    25% { transform: rotate(calc(var(--nagib) - 1.6deg)) scale(calc(1.015 * var(--zrcali)), 0.99); }
    50% { transform: rotate(calc(var(--nagib) + 1.2deg)) scale(calc(0.99 * var(--zrcali)), 1.012); }
    75% { transform: rotate(calc(var(--nagib) - 0.6deg)) scaleX(var(--zrcali)); }
    100% { transform: rotate(var(--nagib)) scaleX(var(--zrcali)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .papir-link:hover :global(.papir-oblika),
    .papir-link:focus-visible :global(.papir-oblika) {
      animation: none;
    }
  }
</style>
