---
// Renders a content block's text, marked as OSNUTEK when the block is a placeholder.
import Placeholder from './Placeholder.astro';

interface Props {
  blok: { besedilo: string; placeholder: boolean };
  class?: string;
}
const { blok, class: className } = Astro.props;
---

<p class={className}>
  {blok.placeholder ? <Placeholder>{blok.besedilo}</Placeholder> : blok.besedilo}
</p>
