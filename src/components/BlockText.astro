---
// Renders a content block's text, marked as OSNUTEK when the block has `osnutek: true`.
import Placeholder from './Placeholder.astro';

interface Props {
  blok: { besedilo: string; osnutek: boolean };
  class?: string;
}
const { blok, class: className } = Astro.props;
---

<p class={className}>
  <Placeholder active={blok.osnutek}>{blok.besedilo}</Placeholder>
</p>
