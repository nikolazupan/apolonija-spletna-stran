---
// Header: partner logo, inline menu on desktop, compact dropdown panel on mobile.
import VesnaLogo from '../brand/VesnaLogo.astro';
import Risba from '../brand/Risba.astro';
import { navigation } from '../../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
// Desktop header skips "Vstopna stran": the logo links home.
const desktopItems = navigation.filter((item) => item.href !== '/');
---

<header class="relative z-30 border-b-2 border-crna/10">
  <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-6 px-5 py-3 sm:px-8 lg:py-4">
    <a href="/" aria-label="Vstopna stran" class="shrink-0">
      <VesnaLogo class="text-[0.85rem] sm:text-[1rem] lg:text-[1.1rem]" />
    </a>

    <nav class="hidden lg:block" aria-label="Glavni meni">
      <ul class="flex flex-wrap justify-end gap-x-5 gap-y-1 text-[0.95rem] font-semibold xl:gap-x-6">
        {desktopItems.map((item) => (
          <li>
            <a href={item.href} class="relative inline-block py-1 hover:text-zelena-temna" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.short}
              {isCurrent(item.href) && <Risba name="podcrta" class="absolute -bottom-0.5 left-0 h-1.5 w-full [--risba-w:3px]" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      id="meni-gumb"
      class="flex items-center gap-2 rounded-full border-2 border-crna px-4 py-1.5 text-sm font-bold lg:hidden"
      aria-expanded="false"
      aria-controls="meni-panel"
    >
      <span class="meni-label">Meni</span>
      <svg viewBox="0 0 16 12" class="h-3 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M1 2h14M1 6h14M1 10h14" />
      </svg>
    </button>
  </div>

  <nav id="meni-panel" class="absolute inset-x-0 top-full hidden border-b-2 border-crna bg-krema lg:hidden" aria-label="Glavni meni">
    <ul class="mx-auto max-w-[90rem] px-5 py-3 sm:px-8">
      {navigation.map((item) => (
        <li class="border-b border-crna/10 last:border-0">
          <a
            href={item.href}
            class:list={['flex items-center justify-between py-3 text-lg font-semibold', isCurrent(item.href) ? 'text-zelena-temna' : 'hover:text-zelena-temna']}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('meni-gumb');
  const panel = document.getElementById('meni-panel');
  const label = button?.querySelector('.meni-label');
  const setOpen = (open: boolean) => {
    panel?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Zapri' : 'Meni';
  };
  button?.addEventListener('click', () => setOpen(panel?.classList.contains('hidden') ?? false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.classList.contains('hidden')) {
      setOpen(false);
      button?.focus();
    }
  });
</script>
