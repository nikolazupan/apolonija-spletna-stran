---
// Header: centered partner logo and a "Meni" button that opens a full-screen overlay (all screen sizes).
import VesnaLogo from '../brand/VesnaLogo.astro';
import { navigation, social } from '../../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));

// Shared by the header and the overlay's top bar, so the logo and buttons line up exactly.
const bar = 'site-container grid grid-cols-[1fr_auto_1fr] items-center gap-3 py-3 lg:py-4';
const logoSize = 'text-[0.9rem] sm:text-[1.1rem] lg:text-[1.25rem]';
const button = 'flex h-11 items-center justify-center gap-2 rounded-full border-2 border-crna text-sm font-bold max-sm:w-11 sm:px-4';
---

<header class="relative z-30 border-b-2 border-crna/10">
  <div class={bar}>
    <span aria-hidden="true"></span>
    <a href="/" aria-label="Vstopna stran">
      <VesnaLogo class={logoSize} />
    </a>
    <button type="button" class:list={['meni-odpri justify-self-end', button]} aria-expanded="false" aria-controls="meni" aria-label="Meni">
      <span class="max-sm:hidden">Meni</span>
      <svg viewBox="0 0 16 12" class="h-3 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M1 2h14M1 6h14M1 10h14" />
      </svg>
    </button>
  </div>
</header>

<div id="meni" class="meni fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true" aria-label="Glavni meni" hidden>
  <div class={bar}>
    <span aria-hidden="true"></span>
    <VesnaLogo class={logoSize} />
    <button type="button" class:list={['meni-zapri justify-self-end border-crna bg-crna text-krema', button]} aria-label="Zapri meni">
      <span class="max-sm:hidden">Zapri</span>
      <svg viewBox="0 0 12 12" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M1 1l10 10M11 1L1 11" />
      </svg>
    </button>
  </div>

  <nav class="mx-auto max-w-3xl px-gutter pb-12 pt-6 sm:pt-10" aria-label="Glavni meni">
    <ul class="md:columns-2 md:gap-x-12">
      {navigation.map((item, i) => (
        <li class="meni-postavka break-inside-avoid border-b border-crna/15" style={`--i:${i}`}>
          <a
            href={item.href}
            class:list={['flex items-baseline gap-4 py-3 text-2xl font-bold tracking-tight sm:py-4 sm:text-[1.7rem]', isCurrent(item.href) ? 'text-zelena-temna' : 'hover:text-zelena-temna']}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <span class="w-6 shrink-0 text-xs font-semibold tabular-nums opacity-60">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <ul class="meni-postavka mt-14 flex justify-center gap-6 text-base font-bold" style={`--i:${navigation.length}`}>
      {social.map((s) => <li><a href={s.href} class="underline underline-offset-4">{s.label}</a></li>)}
    </ul>
  </nav>
</div>

<style>
  /* Overlay: translucent cream with blur, page faintly visible behind. */
  .meni {
    background: rgb(240 232 212 / 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .meni.is-open {
    opacity: 1;
  }
  .meni-postavka {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .meni.is-open .meni-postavka {
    opacity: 1;
    transform: none;
    transition-delay: calc(80ms + var(--i) * 35ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .meni,
    .meni-postavka {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const menu = document.getElementById('meni');
  const openBtn = document.querySelector<HTMLButtonElement>('.meni-odpri');
  const closeBtn = document.querySelector<HTMLButtonElement>('.meni-zapri');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  const open = () => {
    if (!menu) return;
    menu.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
    // force a reflow so the transition starts from the hidden state
    void menu.offsetWidth;
    menu.classList.add('is-open');
    closeBtn?.focus();
  };
  const close = () => {
    if (!menu || menu.hidden) return;
    menu.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    const hide = () => (menu.hidden = true);
    if (reduced.matches) hide();
    else setTimeout(hide, 300);
    openBtn?.focus();
  };

  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (!menu || menu.hidden) return;
    if (e.key === 'Escape') close();
    // keep keyboard focus inside the open menu
    if (e.key === 'Tab') {
      const focusable = menu.querySelectorAll<HTMLElement>('a, button');
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
