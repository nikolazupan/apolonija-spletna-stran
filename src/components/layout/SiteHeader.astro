---
// Sticky header: partner logo left, "Meni" button right (same content edges as the page).
// Once the page is scrolled it turns into a cream paper strip with a torn bottom edge.
// The "Meni" button opens a full-screen overlay (all screen sizes).
import VesnaLogo from '../brand/VesnaLogo.astro';
import Risba from '../brand/Risba.astro';
import { navigation, social } from '../../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));

// Shared by the header and the overlay's top bar, so the logo and buttons line up exactly.
// Phones (below md): one row, logo + hand-drawn icon button (44×44 tap area); from md: "Meni" pill.
const bar = 'site-container relative flex items-center justify-between gap-2 py-2.5 md:gap-4 md:py-3 lg:py-4';
// On phones the logo takes all width left of the 44px icon (logo is ≈16.6em wide), capped at 1.05rem.
const logoSize = 'text-[min(1.05rem,calc((100vw-2*var(--gutter)-3.75rem)/17.6))] md:text-[1.05rem] lg:text-[1.2rem]';
const button = 'flex h-11 w-11 shrink-0 items-center justify-center gap-2 rounded-full text-sm font-bold md:w-auto md:border-2 md:border-crna md:px-4';

// Torn paper edge under the scrolled header: a jagged line, fixed seed so it is stable between builds.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
let rob = 'M0,0 L0,6';
for (let x = 0; x < 1000; ) {
  x = Math.min(1000, x + 10 + rnd() * 22);
  rob += ` L${x.toFixed(1)},${(3 + rnd() * 9).toFixed(1)}`;
}
rob += ' L1000,0 Z';
---

<header class="glava sticky top-0 z-40" data-glava>
  <!-- paper strip + torn edge, visible only once scrolled -->
  <div class="glava-papir pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0"><div class="paper h-full bg-krema"></div></div>
    <svg class="absolute left-0 top-full h-3.5 w-full" viewBox="0 0 1000 14" preserveAspectRatio="none">
      <path d={rob} fill="var(--color-krema)"></path>
    </svg>
  </div>
  <div class={bar}>
    <a href="/" aria-label="Vstopna stran">
      <VesnaLogo class={logoSize} />
    </a>
    <button type="button" class:list={['meni-odpri', button]} aria-expanded="false" aria-controls="meni" aria-label="Meni">
      <Risba name="meni" color="var(--color-crna)" class="h-6 w-7 [--risba-w:3.5px] md:hidden" />
      <span class="max-md:hidden">Meni</span>
      <svg viewBox="0 0 16 12" class="h-3 w-4 max-md:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M1 2h14M1 6h14M1 10h14" />
      </svg>
    </button>
  </div>
</header>

<div id="meni" class="meni fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true" aria-label="Glavni meni" hidden>
  <div class={bar}>
    <VesnaLogo class={logoSize} />
    <button type="button" class:list={['meni-zapri md:border-crna md:bg-crna md:text-krema', button]} aria-label="Zapri meni">
      <Risba name="zapri" color="var(--color-crna)" class="h-6 w-6 md:hidden" />
      <span class="max-md:hidden">Zapri</span>
      <svg viewBox="0 0 12 12" class="h-3 w-3 max-md:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M1 1l10 10M11 1L1 11" />
      </svg>
    </button>
  </div>

  <nav class="mx-auto max-w-3xl px-gutter pb-12 pt-6 sm:pt-10" aria-label="Glavni meni">
    <ul class="md:columns-2 md:gap-x-12">
      {navigation.map((item, i) => (
        <li class="meni-postavka break-inside-avoid border-b border-crna/15" style={`--i:${i}`}>
          <a
            href={item.href}
            class:list={['flex items-baseline gap-4 py-3 text-2xl font-bold tracking-tight sm:py-4 sm:text-[1.7rem]', isCurrent(item.href) ? 'text-zelena-temna' : 'hover:text-zelena-temna']}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <span class="w-6 shrink-0 text-xs font-semibold tabular-nums opacity-60">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <ul class="meni-postavka mt-14 flex justify-center gap-6 text-base font-bold" style={`--i:${navigation.length}`}>
      {social.map((s) => <li><a href={s.href} class="underline underline-offset-4">{s.label}</a></li>)}
    </ul>
  </nav>
</div>

<style>
  /* Header paper: hidden at the top of the page, fades in with a soft shadow under the torn edge once scrolled. */
  .glava-papir {
    opacity: 0;
    transition: opacity 0.25s ease;
    filter: drop-shadow(0 3px 5px rgb(20 20 20 / 0.12));
  }
  .glava[data-scrolled] .glava-papir {
    opacity: 1;
  }

  /* Overlay: translucent cream with blur, page faintly visible behind. */
  .meni {
    background: rgb(240 232 212 / 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .meni.is-open {
    opacity: 1;
  }
  .meni-postavka {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .meni.is-open .meni-postavka {
    opacity: 1;
    transform: none;
    transition-delay: calc(80ms + var(--i) * 35ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .glava-papir,
    .meni,
    .meni-postavka {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Header turns into a paper strip once the page is scrolled.
  const glava = document.querySelector<HTMLElement>('[data-glava]');
  const onScroll = () => glava?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const menu = document.getElementById('meni');
  const openBtn = document.querySelector<HTMLButtonElement>('.meni-odpri');
  const closeBtn = document.querySelector<HTMLButtonElement>('.meni-zapri');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  const open = () => {
    if (!menu) return;
    menu.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
    // force a reflow so the transition starts from the hidden state
    void menu.offsetWidth;
    menu.classList.add('is-open');
    closeBtn?.focus();
  };
  const close = () => {
    if (!menu || menu.hidden) return;
    menu.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    const hide = () => (menu.hidden = true);
    if (reduced.matches) hide();
    else setTimeout(hide, 300);
    openBtn?.focus();
  };

  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (!menu || menu.hidden) return;
    if (e.key === 'Escape') close();
    // keep keyboard focus inside the open menu
    if (e.key === 'Tab') {
      const focusable = menu.querySelectorAll<HTMLElement>('a, button');
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
