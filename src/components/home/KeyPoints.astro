---
// The key programme areas (selected in vstopna.md), each on its own hand-cut paper card.
import type { CollectionEntry } from 'astro:content';
import PaperCard from '../ui/PaperCard.astro';
import ProgramCardBody from '../ui/ProgramCardBody.astro';
import Placeholder from '../Placeholder.astro';
import { papirji } from '../../lib/blob';

interface Props {
  naslov?: string;
  povezavaBesedilo?: string;
  // the selection itself is provisional: marks the whole section as OSNUTEK
  placeholder?: boolean;
  podrocja: CollectionEntry<'program'>[];
}
const { naslov, povezavaBesedilo = 'Celoten program', placeholder = false, podrocja } = Astro.props;
---

<section class="site-container py-12 lg:py-16">
  <Placeholder active={placeholder} as="div" class="block py-4">
    <h2 class="display text-center text-[clamp(2.25rem,7vw,3.5rem)]">{naslov}</h2>

    <ol class="mt-8 grid gap-6 md:grid-cols-3 md:gap-8 lg:mt-10">
      {podrocja.map((p, i) => (
        <li>
          <PaperCard href={`/program/${p.id}`} {...papirji[i % papirji.length]} class="h-full">
            <ProgramCardBody podrocje={p} stevilka={i + 1} />
          </PaperCard>
        </li>
      ))}
    </ol>

    <div class="mt-10 text-center">
      <a href="/program" class="inline-block border-b-[3px] border-zelena pb-0.5 text-base font-bold hover:text-zelena-temna">{povezavaBesedilo} →</a>
    </div>
  </Placeholder>
</section>
