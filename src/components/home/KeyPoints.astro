---
// The 3 most important programme points, each linking to the programme page.
// Centered title, centered text in each column, link to the full programme below.
import Placeholder from '../Placeholder.astro';

interface Props {
  naslov?: string;
  povezavaBesedilo?: string;
  tocke: { naslov: string; besedilo: string; povezava: string; placeholder: boolean }[];
}
const { naslov, povezavaBesedilo = 'Celoten program', tocke } = Astro.props;
---

<section class="mx-auto max-w-[90rem] px-5 py-12 sm:px-8 lg:py-16">
  <h2 class="display text-center text-[clamp(2.25rem,7vw,3.5rem)]">{naslov}</h2>

  <ol class="mt-8 grid border-t-2 border-crna md:grid-cols-3">
    {tocke.map((t, i) => (
      <li class:list={['border-b-2 border-crna', i > 0 && 'md:border-l-2']}>
        <a href={t.povezava} class="group flex h-full flex-col items-center gap-3 px-4 py-7 text-center md:px-8 md:py-9">
          <span class="display text-5xl text-zelena">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-2xl font-extrabold tracking-tight">
            {t.placeholder ? <Placeholder>{t.naslov}</Placeholder> : t.naslov}
          </h3>
          <p class="max-w-xs text-base leading-relaxed">
            {t.placeholder ? <Placeholder>{t.besedilo}</Placeholder> : t.besedilo}
          </p>
          <span class="mt-auto pt-2 text-sm font-bold group-hover:text-zelena-temna">Več v programu →</span>
        </a>
      </li>
    ))}
  </ol>

  <div class="mt-8 text-center">
    <a href="/program" class="inline-flex rounded-full bg-crna px-6 py-3 text-base font-bold text-krema hover:bg-zelena-temna">{povezavaBesedilo} →</a>
  </div>
</section>
