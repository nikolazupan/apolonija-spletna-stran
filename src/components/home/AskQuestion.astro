---
// Q&A box: ask Apolonija a question (UI only, no backend yet) + link to answered questions.
import Placeholder from '../Placeholder.astro';

interface Props {
  naslov: string[];
  povezava: string;
}
const { naslov, povezava } = Astro.props;
// Split off the trailing "?" so it can be set as a separate, tilted cream mark.
const vprasanje = naslov[0].replace(/\?$/, '');
const imaVprasaj = vprasanje !== naslov[0];
---

<section class="paper bg-zelena text-crna">
  <div class="site-container grid gap-8 py-10 lg:grid-cols-12 lg:items-center lg:gap-6 lg:py-14">
    <h2 class="display text-[clamp(2.5rem,9vw,4.25rem)] lg:col-span-5">
      <span class="block">
        {vprasanje}{imaVprasaj && <span class="ml-[0.04em] inline-block origin-bottom-left rotate-12 scale-125 text-krema">?</span>}
      </span>
      <span class="block pl-[0.6em] text-krema">{naslov[1]}</span>
    </h2>

    <div class="lg:col-span-6 lg:col-start-7">
      <Placeholder as="div" class="block">
        <!-- arrow submit button sits inside the field's bottom-right corner -->
        <form id="vprasanje-obrazec" class="relative" novalidate>
          <label for="vprasanje" class="sr-only">Vprašanje za Apolonijo</label>
          <textarea
            id="vprasanje"
            name="vprasanje"
            rows="3"
            required
            class="block w-full resize-y rounded-2xl border-2 border-crna bg-krema py-3 pl-4 pr-16 text-lg placeholder:text-crna/55 focus:outline-none focus:ring-4 focus:ring-crna/30"
            placeholder="Kaj bi vprašal/a Apolonijo?"
          ></textarea>
          <button
            type="submit"
            class="absolute bottom-3 right-3 flex h-11 w-11 items-center justify-center rounded-full bg-crna text-krema transition-colors hover:bg-zelena-temna focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-crna"
            aria-label="Pošlji vprašanje"
            title="Pošlji vprašanje"
          >
            <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" />
            </svg>
          </button>
        </form>
        <p class="mt-2 text-sm font-medium" role="status" id="vprasanje-status">Prototip: obrazec še ne pošilja vprašanj.</p>
      </Placeholder>

      <a href={povezava} class="mt-6 inline-flex items-center gap-2 border-b-[3px] border-crna pb-0.5 text-lg font-bold hover:border-krema hover:text-krema">
        Preberi vprašanja in odgovore →
      </a>
    </div>
  </div>
</section>

<script>
  // No backend yet: keep the user on the page and say so.
  const form = document.getElementById('vprasanje-obrazec') as HTMLFormElement | null;
  const status = document.getElementById('vprasanje-status');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (status) status.textContent = 'Prototip: vprašanje ni bilo poslano. Pošiljanje bo delovalo v končni verziji.';
  });
</script>
