---
// Q&A box: ask Apolonija a question (sent via Web3Forms) + link to answered questions.
import QuestionForm from '../ui/QuestionForm.astro';

interface Props {
  naslov: string[];
  povezava: string;
  // link text
  povezavaBesedilo: string;
}
const { naslov, povezava, povezavaBesedilo } = Astro.props;
// Split off the trailing "?" so it can be set as a separate, tilted cream mark.
const vprasanje = naslov[0].replace(/\?$/, '');
const imaVprasaj = vprasanje !== naslov[0];
---

<section class="paper bg-zelena text-crna">
  <!-- @container: on phones the heading is sized to the content width (cqi), so it spans edge to edge -->
  <div class="site-container @container grid gap-5 py-7 md:gap-8 md:py-10 lg:grid-cols-12 lg:items-center lg:gap-6 lg:py-14">
    <h2 class="vprasanje-naslov display text-[15.2cqi] md:text-[clamp(2.5rem,9vw,4.25rem)] lg:col-span-5">
      <span class="block">
        {vprasanje}{imaVprasaj && <span class="ml-[0.04em] inline-block origin-bottom-left rotate-12 scale-125 text-krema">?</span>}
      </span>
      <span class="block text-krema md:pl-[0.6em]">{naslov[1]}</span>
    </h2>

    <div class="lg:col-span-6 lg:col-start-7">
      <QuestionForm zadeva="Vprašanje z vstopne strani" />

      <a href={povezava} class="mt-4 inline-flex items-center gap-2 border-b-[3px] md:mt-6 border-crna pb-0.5 text-lg font-bold hover:border-krema hover:text-krema">
        {povezavaBesedilo} →
      </a>
    </div>
  </div>
</section>
