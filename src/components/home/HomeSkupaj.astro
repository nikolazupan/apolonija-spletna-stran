---
// Why Apolonija is running, and why Vesna and civil society join forces.
// Two framed blocks of equal size on a shared two-column grid, alternating: title | text, then text | title.
// Titles and paragraphs start at the same top line and share column edges. Stacked on mobile.
import BlockText from '../BlockText.astro';

type Blok = { naslov?: string; besedilo: string; placeholder: boolean };
interface Props {
  kandidatura: Blok;
  bio: Blok;
  skupaj: Blok;
}
const { kandidatura, bio, skupaj } = Astro.props;
const frame = 'grid content-start gap-4 border-2 border-crna p-6 sm:p-8 md:grid-cols-2 md:gap-10 lg:p-10';
const title = 'display text-[clamp(2.25rem,7vw,3.5rem)]';
---

<section class="site-container grid gap-6 pb-12 md:auto-rows-fr lg:gap-8 lg:pb-16">
  <article class={frame}>
    <h2 class={title}>{kandidatura.naslov}</h2>
    <div>
      <BlockText blok={kandidatura} class="max-w-prose text-lg leading-relaxed" />
      <BlockText blok={bio} class="mt-4 max-w-prose text-base font-bold leading-snug" />
      <a href="/apolonija-simon" class="mt-4 inline-block border-b-[3px] border-zelena pb-0.5 text-base font-bold hover:text-zelena-temna">Več o Apoloniji →</a>
    </div>
  </article>

  <article class={frame}>
    <h2 class:list={[title, 'md:order-2']}>{skupaj.naslov}</h2>
    <BlockText blok={skupaj} class="max-w-prose text-lg leading-relaxed md:order-1" />
  </article>
</section>
