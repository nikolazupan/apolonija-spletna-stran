---
// Why Apolonija is running, and why Vesna and civil society join forces.
// Two framed blocks on a shared two-column grid, alternating: title | text, then text | title. Each block is as
// tall as its content (no forced equal height, which left the shorter one half empty).
// Titles and paragraphs start at the same top line and share column edges. Stacked on mobile.
import BlockText from '../BlockText.astro';

type Blok = { naslov?: string; besedilo: string; povezava?: string; podpis?: string; osnutek: boolean };
interface Props {
  kandidatura: Blok;
  // bold sentence from the CV, shown as a quote under the paragraph
  poudarek: Blok;
  skupaj: Blok;
}
const { kandidatura, poudarek, skupaj } = Astro.props;
const frame = 'grid content-start gap-4 border-2 border-crna p-6 sm:p-8 md:grid-cols-2 md:gap-10 lg:p-10';
const title = 'display text-[clamp(2.25rem,7vw,3.5rem)]';
---

<section class="site-container grid gap-6 pb-12 lg:gap-8 lg:pb-16">
  <article class={frame}>
    <h2 class={title}>{kandidatura.naslov}</h2>
    <figure>
      <!-- her own words (first person), from the CV -->
      <blockquote>
        <BlockText blok={kandidatura} class="max-w-prose text-lg leading-relaxed" />
        <BlockText blok={poudarek} class="mt-5 max-w-prose border-l-[3px] border-zelena pl-4 font-display text-[1.35rem] font-extrabold leading-[1.15] tracking-[-0.02em] [font-stretch:85%] sm:text-2xl" />
      </blockquote>
      {poudarek.podpis && <figcaption class="mt-3 text-sm font-bold text-crna/70">{poudarek.podpis}</figcaption>}
      {kandidatura.povezava && <a href="/apolonija-simon" class="mt-4 inline-block border-b-[3px] border-zelena pb-0.5 text-base font-bold hover:text-zelena-temna">{kandidatura.povezava} →</a>}
    </figure>
  </article>

  <article class={frame}>
    <h2 class:list={[title, 'md:order-2']}>{skupaj.naslov}</h2>
    <BlockText blok={skupaj} class="max-w-prose text-lg leading-relaxed md:order-1" />
  </article>
</section>
