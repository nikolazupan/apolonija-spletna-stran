---
// Why Vesna and civil society join forces, and why Apolonija is running.
// Framed blocks with alternating columns: title | text, then text | title. Stacked on mobile.
import BlockText from '../BlockText.astro';

type Blok = { naslov?: string; besedilo: string; placeholder: boolean };
interface Props {
  skupaj: Blok;
  kandidatura: Blok;
  bio: Blok;
}
const { skupaj, kandidatura, bio } = Astro.props;
const frame = 'grid gap-4 border-2 border-crna p-6 sm:p-8 md:grid-cols-2 md:gap-10 lg:p-10';
---

<section class="mx-auto max-w-[90rem] space-y-6 px-5 py-12 sm:px-8 lg:space-y-8 lg:py-16">
  <article class={frame}>
    <h2 class="display text-[clamp(2.25rem,7vw,3.5rem)]">{skupaj.naslov}</h2>
    <BlockText blok={skupaj} class="max-w-prose text-lg leading-relaxed md:self-center" />
  </article>

  <article class:list={[frame, 'md:ml-[6%]']}>
    <h2 class="display text-[clamp(2.25rem,7vw,3.5rem)] md:order-2 md:text-right">{kandidatura.naslov}</h2>
    <div class="md:order-1 md:self-center">
      <BlockText blok={kandidatura} class="max-w-prose text-lg leading-relaxed" />
      <BlockText blok={bio} class="mt-4 max-w-prose text-base font-bold leading-snug" />
      <a href="/apolonija-simon" class="mt-4 inline-block border-b-[3px] border-zelena pb-0.5 text-base font-bold hover:text-zelena-temna">Več o Apoloniji →</a>
    </div>
  </article>
</section>
