---
// Prominent link to the online survey: green band with a hand-circled question mark.
import Swoosh from '../brand/Swoosh.astro';
import BlockText from '../BlockText.astro';

interface Props {
  blok: { naslov?: string; besedilo: string; placeholder: boolean };
}
const { blok } = Astro.props;
---

<section class="paper bg-zelena text-crna">
  <a href="/anketa" class="group mx-auto grid max-w-[90rem] items-center gap-8 px-5 py-14 sm:grid-cols-[auto_1fr] sm:gap-14 sm:px-10 lg:py-20">
    <span class="relative inline-flex h-36 w-36 items-center justify-center font-display text-[8rem] font-extrabold leading-none text-krema sm:h-52 sm:w-52 sm:text-[11rem]" aria-hidden="true">
      <Swoosh shape="ring" color="var(--color-crna)" class="absolute -inset-4 h-[calc(100%+2rem)] w-[calc(100%+2rem)] transition-transform duration-300 group-hover:rotate-12 [--swoosh-w:6px]" />
      ?
    </span>
    <div>
      <h2 class="display text-6xl sm:text-8xl">{blok.naslov}</h2>
      <BlockText blok={blok} class="mt-4 max-w-xl text-lg font-medium leading-snug sm:text-xl" />
      <span class="mt-6 inline-flex rounded-full bg-crna px-6 py-3 text-lg font-bold text-krema group-hover:bg-krema group-hover:text-crna">Izpolni anketo →</span>
    </div>
  </a>
</section>
