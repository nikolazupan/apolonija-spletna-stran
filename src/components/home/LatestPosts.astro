---
// "Iz arhiva": title row with archive link, then a row of recent posts (the newest one is in the hero).
// Horizontally scrollable on mobile. Thumbnails only, embeds load on click (PostCard).
import type { CollectionEntry } from 'astro:content';
import PostCard from '../ui/PostCard.astro';

interface Props {
  objave: CollectionEntry<'objave'>[];
  naslov?: string;
  povezavaArhiv?: string;
}
const { objave, naslov = 'Iz arhiva', povezavaArhiv = 'Vse objave' } = Astro.props;
const tilt = ['-rotate-1', 'rotate-1', 'rotate-[0.5deg]', '-rotate-[1.5deg]'];
---

<section class="py-12 lg:py-16">
  <div class="site-container flex flex-wrap items-end justify-between gap-4">
    <h2 class="display text-[clamp(2.25rem,7vw,3.5rem)]">{naslov}</h2>
    <a href="/arhiv" class="border-b-[3px] border-zelena pb-0.5 text-base font-bold hover:text-zelena-temna">{povezavaArhiv} →</a>
  </div>

  <ul class="site-container mt-8 flex snap-x snap-mandatory scroll-px-[var(--gutter)] gap-5 overflow-x-auto pb-4 pt-2 md:grid md:grid-cols-4 md:overflow-visible">
    {objave.map((objava, i) => (
      <li class="w-[68%] shrink-0 snap-start sm:w-[42%] md:w-auto">
        <PostCard objava={objava} sizes="(min-width: 768px) 22vw, 68vw" class={tilt[i % tilt.length]} />
      </li>
    ))}
  </ul>
</section>
