---
// Latest social media post (thumbnail only, no Meta scripts) with a link to the archive.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import HandLine from '../brand/HandLine.astro';
import ImagePlaceholder from '../ImagePlaceholder.astro';
import Placeholder from '../Placeholder.astro';
import { formatDatum, tipOznaka } from '../../lib/objave';

interface Props {
  objava?: CollectionEntry<'objave'>;
  naslov?: string;
  povezavaArhiv?: string;
}
const { objava, naslov = 'Zadnja objava', povezavaArhiv = 'Vse objave' } = Astro.props;
const o = objava?.data;
---

<section class="mx-auto grid max-w-[90rem] gap-10 px-5 py-16 sm:px-10 lg:grid-cols-12 lg:py-24">
  <div class="relative lg:col-span-5">
    <h2 class="display text-6xl sm:text-8xl">{naslov}</h2>
    <HandLine shape="arrow" class="mt-4 hidden h-16 w-40 rotate-6 lg:ml-auto lg:block [--line-w:4px]" />
    <a href="/arhiv" class="mt-8 inline-block border-b-[3px] border-zelena pb-0.5 text-lg font-bold hover:text-zelena-temna">{povezavaArhiv} →</a>
  </div>

  {o && (
    <article class="max-w-md lg:col-span-5 lg:col-start-7">
      <a href={o.povezava} target="_blank" rel="noopener" class="block rotate-2 border-[10px] border-bela bg-bela transition-transform hover:rotate-0">
        {o.slika
          ? <Image src={o.slika} alt={o.opis} widths={[400, 800]} sizes="(min-width: 1024px) 28rem, 100vw" class="aspect-square w-full object-cover" />
          : <ImagePlaceholder label={`OBJAVA: ${tipOznaka[o.tip].toUpperCase()}`} class="aspect-square w-full" />}
        <div class="px-1 pb-1 pt-4">
          <p class="flex justify-between text-sm font-bold">
            <time datetime={o.datum.toISOString()}>{formatDatum(o.datum)}</time>
            <span class="text-zelena-temna">{tipOznaka[o.tip]}</span>
          </p>
          <p class="mt-2 text-base leading-snug">{o.placeholder ? <Placeholder>{o.opis}</Placeholder> : o.opis}</p>
          <p class="mt-3 text-sm font-bold">Odpri na {o.platforma === 'instagram' ? 'Instagramu' : 'Facebooku'} ↗</p>
        </div>
      </a>
    </article>
  )}
</section>
