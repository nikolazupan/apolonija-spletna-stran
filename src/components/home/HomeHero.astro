---
// Homepage hero: her name as the page heading, cut-out photo, circled ballot number.
import foto from '../../assets/foto/dezniki-izrez.jpg';
import CutoutImage from '../brand/CutoutImage.astro';
import CandidateMark from '../brand/CandidateMark.astro';
import Risba from '../brand/Risba.astro';

interface Props {
  hero: {
    podnaslov: string;
    stevilka: number;
    volitve: string;
  };
}
const { hero } = Astro.props;
---

<section class="mx-auto grid max-w-[90rem] items-center gap-8 px-5 pb-12 pt-8 sm:px-8 lg:grid-cols-12 lg:gap-6 lg:pb-16 lg:pt-12">
  <div class="lg:col-span-7">
    <CandidateMark as="h1" tagline={hero.podnaslov} class="ml-[0.3em] text-[clamp(3.75rem,16vw,8.5rem)]" />

    <div class="mt-8 flex items-center gap-5 lg:mt-10">
      <span class="relative inline-flex h-20 w-20 shrink-0 items-center justify-center font-display text-5xl font-extrabold" aria-hidden="true">
        <Risba name="krog" class="absolute -inset-2.5 h-[calc(100%+1.25rem)] w-[calc(100%+1.25rem)] [--risba-w:4px]" />
        {hero.stevilka}
      </span>
      <p class="text-sm font-bold uppercase leading-tight tracking-wide">
        <span class="sr-only">Na glasovnici za županjo </span>Obkroži {hero.stevilka}<br />
        <span class="font-medium normal-case tracking-normal">{hero.volitve}</span>
      </p>
    </div>
  </div>

  <a
    href="/apolonija-simon"
    class="mx-auto block w-[85%] max-w-sm rotate-2 transition-transform hover:rotate-0 sm:w-[60%] lg:col-span-5 lg:w-full lg:max-w-md"
    aria-label="Več o Apoloniji Simon"
  >
    <CutoutImage
      src={foto}
      alt="Apolonija Simon pod dežnikom ob vodnjaku v središču Ljubljane"
      variant="d"
      widths={[400, 500]}
      sizes="(min-width: 1024px) 28rem, 85vw"
      loading="eager"
      imgClass="aspect-[4/5] object-[50%_40%]"
    />
  </a>
</section>
