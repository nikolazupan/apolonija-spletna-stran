---
// Homepage hero, composed like the posters: her name on an organic white shape,
// the cut-out photo on its own white "paper" shape. Only the white shapes overlap;
// the photo has its own column (desktop) or row (mobile) and never covers text.
import foto from '../../assets/foto/dezniki-izrez.jpg';
import Blob from '../brand/Blob.astro';
import CutoutImage from '../brand/CutoutImage.astro';
import CandidateMark from '../brand/CandidateMark.astro';
import Risba from '../brand/Risba.astro';

interface Props {
  hero: {
    podnaslov: string;
    stevilka: number;
    volitve: string;
  };
}
const { hero } = Astro.props;
---

<section class="mx-auto max-w-[90rem] overflow-x-clip px-3 pb-12 pt-6 sm:px-8 lg:pb-24 lg:pt-10">
  <div class="grid lg:grid-cols-12 lg:items-center">
    <!-- name: text in columns 1–7, white shape reaches further right, under the photo's paper -->
    <div class="relative z-10 lg:col-span-7 lg:col-start-1 lg:row-start-1">
      <Blob variant="e" fill="var(--color-bela)" class="absolute inset-y-0 left-0 h-full w-full lg:w-[118%]" />
      <div class="relative px-7 pb-20 pt-12 sm:px-12 sm:pb-24 lg:py-20 lg:pl-14 lg:pr-6">
        <CandidateMark as="h1" tagline={hero.podnaslov} class="ml-[0.25em] text-[clamp(3.5rem,15vw,7rem)] lg:text-[clamp(4rem,7.6vw,8rem)]" />

        <div class="mt-7 flex items-center gap-5 lg:mt-9">
          <span class="relative inline-flex h-16 w-16 shrink-0 items-center justify-center font-display text-4xl font-extrabold sm:h-20 sm:w-20 sm:text-5xl" aria-hidden="true">
            <Risba name="krog" class="absolute -inset-2.5 h-[calc(100%+1.25rem)] w-[calc(100%+1.25rem)] [--risba-w:4px]" />
            {hero.stevilka}
          </span>
          <p class="text-sm font-bold uppercase leading-tight tracking-wide">
            <span class="sr-only">Na glasovnici za županjo </span>Obkroži {hero.stevilka}<br />
            <span class="font-medium normal-case tracking-normal">{hero.volitve}</span>
          </p>
        </div>
      </div>
    </div>

    <!-- photo on its own paper shape: below the name's padding on mobile, in columns 8–12 on desktop -->
    <a
      href="/apolonija-simon"
      class="hero-foto group relative z-20 -mt-10 mr-4 ml-auto block w-[72%] max-w-sm sm:-mt-12 sm:w-[50%] lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:mt-0 lg:mr-0 lg:w-[86%] lg:max-w-[30rem] lg:translate-y-8 lg:justify-self-center"
      aria-label="Več o Apoloniji Simon"
    >
      <Blob variant="f" fill="var(--color-bela)" class="absolute -inset-[7%] h-[114%] w-[114%] -rotate-6 transition-transform duration-500 group-hover:-rotate-3" />
      <CutoutImage
        src={foto}
        alt="Apolonija Simon pod dežnikom, nanjo pada curek vodnjaka v središču Ljubljane"
        variant="d"
        widths={[400, 640]}
        sizes="(min-width: 1024px) 28rem, 72vw"
        loading="eager"
        class="relative rotate-3 transition-transform duration-500 group-hover:rotate-1"
        imgClass="aspect-[4/5] object-center"
      />
    </a>
  </div>
</section>
