---
// Homepage hero, composed like the posters: her name on an organic white shape,
// the cut-out photo on its own green (print green) "paper" shape, which flips to the latest post. Only the white shapes overlap;
// the photo has its own column (desktop) or row (mobile) and never covers text.
import ShapedText from '../brand/ShapedText.astro';
import type { CollectionEntry } from 'astro:content';
import HeroObrat from './HeroObrat.astro';
import GlasovnicaSest from '../brand/GlasovnicaSest.astro';
import CandidateMark from '../brand/CandidateMark.astro';

interface Props {
  hero: {
    podnaslov: string;
    obkrozi?: string;
  };
  // newest post, shown on the back of the green shape
  objava?: CollectionEntry<'objave'>;
}
const { hero, objava } = Astro.props;
---

<!-- @container: the name scales with the content width (cqi), not the window, so it stays inside its column -->
<section class="site-container @container overflow-x-clip pb-12 pt-6 md:pb-14 md:pt-8 lg:pb-16 lg:pt-10">
  <!-- two columns from md (tablets too); md:pl shifts the whole composition right, so the empty space left and right of it is balanced -->
  <div class="hero-mreza grid md:grid-cols-12 md:items-center md:pl-[5%]">
    <!-- name: text in columns 1–6, white shape reaches further right, under the photo's paper -->
    <!-- on desktop the shape reaches further right, under the photo (--oblik-dodatno) -->
    <ShapedText variant="e" class="relative z-10 md:col-span-6 md:col-start-1 md:row-start-1 md:[--oblik-dodatno:37%]">
        <CandidateMark
          as="h1"
          stroke={false}
          tagline={hero.podnaslov}
          class="text-[clamp(3.6rem,16.5vw,7.5rem)] md:text-[clamp(2.75rem,10cqi,9rem)]"
        />
        <!-- mayoral ballot mark, absolutely positioned so the white shape keeps its size:
             tablet and desktop: lower right, below and beside the tagline, just left of the green shape; hidden on phones -->
        {hero.obkrozi && (
          <GlasovnicaSest besedilo={hero.obkrozi} class="absolute -bottom-14 -right-4 max-md:hidden lg:-bottom-11" />
        )}

    </ShapedText>

    <!-- photo / latest post on the green paper shape (flips, see HeroObrat): large and centered under the name on phones, columns 7–12 from md (tablets and desktop) -->
    <div class="hero-foto relative z-20 mx-auto -mt-6 block w-[86%] max-w-md md:col-span-6 md:col-start-7 md:row-start-1 md:mx-0 md:mt-0 md:w-[78%] md:max-w-[30rem] md:justify-self-start">
      <HeroObrat objava={objava} />
    </div>
  </div>
</section>
