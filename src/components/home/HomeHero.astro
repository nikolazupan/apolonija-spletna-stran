---
// Homepage hero, composed like the posters: her name on an organic white shape,
// the cut-out photo on its own green (print green) "paper" shape. Only the white shapes overlap;
// the photo has its own column (desktop) or row (mobile) and never covers text.
import foto from '../../assets/foto/dezniki-izrez.jpg';
// tighter crop for phones: she fills the frame
import fotoBlizje from '../../assets/foto/dezniki-blizje.jpg';
import Blob from '../brand/Blob.astro';
import ShapedText from '../brand/ShapedText.astro';
import CutoutImage from '../brand/CutoutImage.astro';
import CandidateMark from '../brand/CandidateMark.astro';

interface Props {
  hero: {
    podnaslov: string;
  };
}
const { hero } = Astro.props;
---

<!-- @container: the name scales with the content width (cqi), not the window, so it stays inside its column -->
<section class="site-container @container overflow-x-clip pb-12 pt-6 lg:pb-16 lg:pt-10">
  <!-- lg:pl shifts the whole composition right, so the empty space left and right of it is balanced -->
  <div class="hero-mreza grid lg:grid-cols-12 lg:items-center lg:pl-[5%]">
    <!-- name: text in columns 1–6, white shape reaches further right, under the photo's paper -->
    <!-- on desktop the shape reaches further right, under the photo (--oblik-dodatno) -->
    <ShapedText variant="e" class="relative z-10 lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:[--oblik-dodatno:37%]">
        <CandidateMark
          as="h1"
          stroke={false}
          tagline={hero.podnaslov}
          class="text-[clamp(3.6rem,16.5vw,7.5rem)] lg:text-[clamp(4rem,10cqi,9rem)]"
        />

    </ShapedText>

    <!-- photo on its own paper shape: large and centered under the name on phones, columns 7–12 on desktop -->
    <a
      href="/apolonija-simon"
      class="hero-foto group relative z-20 mx-auto -mt-6 block w-[86%] max-w-md md:-mt-10 md:mr-[9%] md:ml-auto md:w-[50%] md:max-w-sm lg:col-span-6 lg:col-start-7 lg:row-start-1 lg:mt-0 lg:mr-0 lg:ml-0 lg:w-[78%] lg:max-w-[30rem] lg:justify-self-start"
      aria-label="Več o Apoloniji Simon"
    >
      <Blob variant="f" fill="var(--color-zelena)" class="absolute -inset-[7%] h-[114%] w-[114%] -rotate-6 transition-transform duration-500 group-hover:-rotate-3" />
      <CutoutImage
        src={fotoBlizje}
        alt="Apolonija Simon pod dežnikom, nanjo pada curek vodnjaka v središču Ljubljane"
        variant="d"
        widths={[448]}
        sizes="86vw"
        loading="eager"
        class="relative rotate-3 md:hidden"
        imgClass="aspect-[4/5] object-center"
      />
      <CutoutImage
        src={foto}
        alt="Apolonija Simon pod dežnikom, nanjo pada curek vodnjaka v središču Ljubljane"
        variant="d"
        widths={[400, 640]}
        sizes="(min-width: 1024px) 28rem, 50vw"
        loading="eager"
        class="relative rotate-3 transition-transform duration-500 group-hover:rotate-1 max-md:hidden"
        imgClass="aspect-[4/5] object-center"
      />
    </a>
  </div>
</section>
