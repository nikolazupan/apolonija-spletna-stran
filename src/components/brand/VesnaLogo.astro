---
// Partner logo block as on the banners: "Vesna – zelena stranka" logo, "in", "civilna družba".
// Two partners side by side, not one merged organization.
// The symbol is the official Vesna mark (src/assets/vesna-znak.svg), always in its own green #00A760;
// `color` only sets the text color.
import VesnaZnak from '../../assets/vesna-znak.svg';
interface Props {
  class?: string;
  color?: string;
  // row: header/footer; stack: vertical, like the Facebook banner
  layout?: 'row' | 'stack';
}
const { class: className, color = 'var(--color-zelena)', layout = 'row' } = Astro.props;
const stack = layout === 'stack';
---

<div
  class:list={['flex font-display font-extrabold uppercase leading-[1.02] tracking-[0.01em]', stack ? 'flex-col items-start gap-[0.7em]' : 'items-center gap-[0.9em]', className]}
  style={`color:${color}`}
  role="img"
  aria-label="Vesna – zelena stranka in civilna družba"
>
  <span class:list={['flex gap-[0.6em]', stack ? 'flex-col items-start' : 'items-center']}>
    <VesnaZnak class="h-[3em] w-auto shrink-0" aria-hidden="true" />
    <span>Vesna<br />zelena<br />stranka</span>
  </span>
  <span class="text-[1.5em] font-bold normal-case leading-none tracking-normal" aria-hidden="true">in</span>
  <span>Civilna<br />družba</span>
</div>
