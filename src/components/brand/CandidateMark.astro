---
// Campaign mark "Apolonija Simon." + tagline, as on the billboards.
// Rendered as the page heading on the homepage (as="h1"). The crayon stroke is optional.
import Risba from './Risba.astro';

interface Props {
  as?: 'p' | 'h1' | 'h2';
  class?: string;
  tagline?: string;
  inverse?: boolean;
  stroke?: boolean;
}
const { as: Tag = 'p', class: className, tagline = 'za županjo.', inverse = false, stroke = true } = Astro.props;
---

<Tag class:list={['display', inverse ? 'text-bela' : 'text-crna', className]}>
  <span class:list={['relative block w-fit', stroke && 'pl-[0.3em]']}>
    {stroke && <Risba name="poteza" class="absolute -left-[0.28em] -top-[0.32em] h-[1.7em] w-[0.7em] [--risba-w:6px]" />}
    Apolonija<br /><span class="pl-[0.8em]">Simon.</span>
  </span>
  {tagline && (
    <span class:list={['mt-[0.22em] block text-[0.38em] leading-[1.05] tracking-[-0.02em]', stroke && 'pl-[0.3em]', inverse ? 'text-zelena' : 'text-zelena-temna']}>
      {tagline}
    </span>
  )}
</Tag>
